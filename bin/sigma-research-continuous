#!/usr/bin/env python3
"""
sigma-research-continuous — Weekly edge discovery loop for all sigma accounts.

For each sigma account, runs the Reflexion research agent and compares the
result to the current champion. If the challenger beats the champion by >10%
on Sharpe, a proposal is written to memory/proposals/ for human review.

Designed to be run as a weekly cron job or systemd timer:

    # /etc/cron.d/sigma-research  (or crontab -e)
    0 6 * * 1  iconbaypark2900  /home/iconbaypark2900/liaison-agentSystem/bin/sigma-research-continuous

Usage:
    sigma-research-continuous                    # run all accounts
    sigma-research-continuous --accounts options_income oanda_forex
    sigma-research-continuous --seed-champions   # seed champions from last known configs
    sigma-research-continuous --show-proposals   # print pending proposals and exit
    sigma-research-continuous --apply-proposal options_income  # mark applied
"""

from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

_root = Path(__file__).resolve().parent.parent
if str(_root) not in sys.path:
    sys.path.insert(0, str(_root))

# Auto-load env from .env.local
_env = _root.parent / "chat-ui" / ".env.local"
if _env.exists():
    for _line in _env.read_text().splitlines():
        if "=" in _line and not _line.startswith("#"):
            k, _, v = _line.partition("=")
            if k.strip() and v.strip() and k.strip() not in os.environ:
                os.environ[k.strip()] = v.strip()

from reflexion_dspy.champion_tracker import (
    is_improvement,
    list_pending_proposals,
    load_champion,
    mark_proposal_applied,
    save_champion,
    write_proposal,
)
from reflexion_dspy.research_agent import StrategyResearchAgent


# ─── Account definitions ─────────────────────────────────────────────────────
