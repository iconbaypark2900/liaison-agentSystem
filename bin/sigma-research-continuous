# ─── Runner ──────────────────────────────────────────────────────────────────

def _run_account(account: str, cfg: dict, verbose: bool = True) -> dict:
    """Run one research cycle for a single account. Returns a result summary dict."""

    def log(msg: str) -> None:
        if verbose:
            print(msg, flush=True)

    log(f"\n{'─'*60}")
    log(f"[{account}] Starting research run")
    log(f"  Question: {cfg['question'][:80]}...")

    champion = load_champion(account)
    if champion:
        ch_sh = champion["oos_stats"].get("sharpe", 0)
        log(f"  Champion: {champion['strategy']} | Sharpe={ch_sh:.4f}")
    else:
        log("  Champion: (none — first passing result wins)")

    agent = StrategyResearchAgent(
        research_question=cfg["question"],
        asset_class=cfg["asset_class"],
        universe=cfg["universe"],
        max_attempts=cfg["max_attempts"],
        backtest_type=cfg["backtest_type"],
        options_underlying=cfg.get("underlying", "SPY"),
    )

    try:
        outcome = agent.run()
    except Exception as exc:
        log(f"  [ERROR] Research agent raised: {exc}")
        return {"account": account, "status": "error", "error": str(exc)}

    if not outcome.edge_found:
        log(f"  Result: NO EDGE FOUND after {outcome.attempts} attempts.")
        return {
            "account": account,
            "status": "no_edge",
            "attempts": outcome.attempts,
            "summary": outcome.summary,
        }

    log(f"  Result: EDGE FOUND — {outcome.winning_strategy}")
    log(f"  OOS: {json.dumps(outcome.oos_stats, indent=6)}")

    # Flatten oos_stats — options harness wraps in {"options": {...}}
    raw_stats = outcome.oos_stats
    if "options" in raw_stats and isinstance(raw_stats["options"], dict):
        flat_stats = raw_stats["options"]
    else:
        # equity harness may nest by strategy name
        first_val = next(iter(raw_stats.values()), {}) if isinstance(raw_stats, dict) else {}
        flat_stats = first_val if isinstance(first_val, dict) and "sharpe" in first_val else raw_stats

    improved, reason = is_improvement(account, flat_stats)
    log(f"  vs Champion: {reason}")

    if improved:
        ch_stats = champion["oos_stats"] if champion else None
        prop_path = write_proposal(
            account,
            config=outcome.oos_stats,
            strategy=outcome.winning_strategy,
            symbols=outcome.winning_symbols,
            oos_stats=flat_stats,
            research_question=cfg["question"],
            backtest_type=cfg["backtest_type"],
            improvement_reason=reason,
            champion_stats=ch_stats,
        )
        save_champion(
            account,
            config=outcome.oos_stats,
            strategy=outcome.winning_strategy,
            symbols=outcome.winning_symbols,
            oos_stats=flat_stats,
            research_question=cfg["question"],
            backtest_type=cfg["backtest_type"],
        )
        log(f"  *** CHAMPION UPDATED *** — proposal written to {prop_path}")
        return {
            "account": account,
            "status": "improved",
            "strategy": outcome.winning_strategy,
            "oos_stats": flat_stats,
            "reason": reason,
            "proposal_path": str(prop_path),
        }
    else:
        log(f"  Champion holds — no update needed.")
        return {
            "account": account,
            "status": "champion_holds",
            "strategy": outcome.winning_strategy,
            "oos_stats": flat_stats,
            "reason": reason,
        }


def _show_proposals() -> None:
    proposals = list_pending_proposals()
    if not proposals:
        print("No pending proposals.")
        return
    for p in proposals:
        print(f"\n{'═'*60}")
        print(f"Account:  {p['account']}")
        print(f"Proposed: {p['proposed_at']}")
        print(f"Strategy: {p['proposed_strategy']}")
        print(f"Symbols:  {p['proposed_symbols']}")
        ch = p.get("champion_oos") or {}
        ch_sh = ch.get("sharpe", "?") if ch else "?"
        new_sh = p["challenger_oos"].get("sharpe", "?")
        print(f"Sharpe:   champion={ch_sh} → challenger={new_sh}")
        print(f"Reason:   {p['improvement_reason']}")
        print(f"Action:   {p['action_required']}")


def _seed_champions() -> None:
    for account, seed in SEED_CHAMPIONS.items():
        existing = load_champion(account)
        if existing:
            print(f"[{account}] Champion already set — skipping seed.")
            continue
        save_champion(
            account,
            config=seed["config"],
            strategy=seed["strategy"],
            symbols=seed["symbols"],
            oos_stats=seed["oos_stats"],
            research_question=seed["research_question"],
            backtest_type=seed["backtest_type"],
            notes=seed.get("notes", ""),
        )
        print(f"[{account}] Seeded champion: {seed['strategy']} | Sharpe={seed['oos_stats'].get('sharpe')}")


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument(
        "--accounts", nargs="+",
        choices=list(ACCOUNT_CONFIGS.keys()),
        default=list(ACCOUNT_CONFIGS.keys()),
        help="Which accounts to run (default: all)",
    )
    ap.add_argument("--seed-champions", action="store_true",
                    help="Seed champion files from prior research and exit")
    ap.add_argument("--show-proposals", action="store_true",
                    help="Print pending proposals and exit")
    ap.add_argument("--apply-proposal", metavar="ACCOUNT",
                    help="Mark a pending proposal as applied")
    ap.add_argument("--quiet", action="store_true",
                    help="Suppress per-account progress output")
    args = ap.parse_args()

    if args.seed_champions:
        _seed_champions()
        return 0

    if args.show_proposals:
        _show_proposals()
        return 0

    if args.apply_proposal:
        mark_proposal_applied(args.apply_proposal)
        print(f"Marked {args.apply_proposal} proposal as applied.")
        return 0

    results = []
    for account in args.accounts:
        cfg = ACCOUNT_CONFIGS[account]
        result = _run_account(account, cfg, verbose=not args.quiet)
        results.append(result)

    print(f"\n{'═'*60}")
    print("RUN SUMMARY")
    for r in results:
        status = r["status"].upper()
        line = f"  {r['account']:<22} {status}"
        if r["status"] == "improved":
            sh = r["oos_stats"].get("sharpe", "?")
            line += f" — new champion Sharpe={sh}"
        elif r["status"] == "champion_holds":
            sh = r["oos_stats"].get("sharpe", "?")
            line += f" — challenger Sharpe={sh}"
        elif r["status"] == "error":
            line += f" — {r.get('error', '')[:60]}"
        print(line)
    print("═"*60)

    pending = list_pending_proposals()
    if pending:
        print(f"\n{len(pending)} pending proposal(s). Review with: sigma-research-continuous --show-proposals")

    improved = [r for r in results if r["status"] == "improved"]
    return 0 if not improved or True else 0  # always 0 — scheduler shouldn't retry on "no improvement"


if __name__ == "__main__":
    raise SystemExit(main())
