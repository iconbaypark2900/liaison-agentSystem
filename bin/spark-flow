    )
    p.add_argument("--project", required=True, metavar="NAME", help="Registered repo key")
    p.add_argument("--task-id", dest="task_id", metavar="TASK_ID", help="Open task id")
    p.set_defaults(func=reporter_step_advance_browser_cmd)

    p = sub.add_parser("look")
    p.add_argument("--refresh", action="store_true")
    p.add_argument("--interactive", action="store_true")
    p.set_defaults(func=look_cmd)

    p = sub.add_parser("tui", help="Open Liaison command center (alias for command-center)")
    p.add_argument("--refresh", action="store_true")
    p.add_argument("--once", action="store_true")
    p.add_argument("--json", action="store_true", help="Print JSON state and exit")
    p.add_argument("--project", metavar="NAME", help="Focus state on one registered project")
    p.add_argument("--task", metavar="TASK_ID", help="Active task id for focused project")
    p.add_argument("--pattern", metavar="PATTERN_ID", help="Active hub pattern id")
    p.add_argument("--persist-session", action="store_true", help="Write operator_session.json")
    p.set_defaults(func=command_center_cmd)

    p_ts = sub.add_parser("terminal-session", help="Register/list terminal agent sessions")
    p_ts_sub = p_ts.add_subparsers(dest="terminal_session_action", required=True)
    p_ts_list = p_ts_sub.add_parser("list", help="List sessions (prunes dead PIDs)")
    p_ts_list.set_defaults(func=terminal_session_cmd)
    p_ts_prune = p_ts_sub.add_parser("prune", help="Remove dead sessions")
    p_ts_prune.set_defaults(func=terminal_session_cmd)
    p_ts_reg = p_ts_sub.add_parser("register", help="Register a spawned session")
    p_ts_reg.add_argument("--agent-name", required=True)
    p_ts_reg.add_argument("--launch", required=True)
    p_ts_reg.add_argument("--pid", type=int, default=None)
    p_ts_reg.add_argument("--title", default="")
    p_ts_reg.add_argument("--project", metavar="NAME", help="Registry project key")
    p_ts_reg.add_argument("--task-id", metavar="TASK_ID", help="Bound venture task id")
    p_ts_reg.add_argument("--pattern", metavar="PATTERN_ID", help="Hub pattern id")
    p_ts_reg.add_argument("--repo-path", help="Repo path (auto from --project if omitted)")
    p_ts_reg.set_defaults(func=terminal_session_cmd)
    p_ts_done = p_ts_sub.add_parser("complete", help="End session and record executor outcome")
    p_ts_done.add_argument("--session-id", help="Terminal session id")
    p_ts_done.add_argument("--agent-name", help="Agent name (running session)")
    p_ts_done.add_argument("--agent", help="Alias for --agent-name")
    p_ts_done.add_argument("--exit-code", type=int, default=None)
    p_ts_done.add_argument("--outcome", choices=["success", "failure", "unknown"])
    p_ts_done.add_argument("--log-excerpt", default="")
    p_ts_done.add_argument("--log-file", help="Read tail from log file")
    p_ts_done.add_argument("--log-lines", type=int, default=40)
    p_ts_done.add_argument("--project", metavar="NAME")
    p_ts_done.add_argument("--task-id", metavar="TASK_ID")
    p_ts_done.add_argument("--attach-file", metavar="PATH")
    p_ts_done.add_argument("--attach-text")
    p_ts_done.add_argument("--attach-title", default="")
    p_ts_done.set_defaults(func=terminal_session_cmd, terminal_session_action="complete")

    p_obs = sub.add_parser("observe-session", help="Start or complete executor sessions (execution bridge)")
    p_obs_sub = p_obs.add_subparsers(dest="observe_session_action", required=True)
    p_obs_start = p_obs_sub.add_parser("start", help="Register venture-bound terminal session")
    p_obs_start.add_argument("--agent", default="hermes")
    p_obs_start.add_argument("--agent-name", help="Alias for --agent")
    p_obs_start.add_argument("--launch", required=True)
    p_obs_start.add_argument("--pid", type=int, default=None)
    p_obs_start.add_argument("--title", default="")
    p_obs_start.add_argument("--project", metavar="NAME")
    p_obs_start.add_argument("--task-id", metavar="TASK_ID")
    p_obs_start.add_argument("--pattern", metavar="PATTERN_ID")
    p_obs_start.set_defaults(func=observe_session_cmd, terminal_session_action="register")
    p_obs_done = p_obs_sub.add_parser("complete", help="Record session outcome to task artifacts")
    p_obs_done.add_argument("--session-id")
    p_obs_done.add_argument("--agent")
    p_obs_done.add_argument("--agent-name")
    p_obs_done.add_argument("--exit-code", type=int, default=None)
    p_obs_done.add_argument("--outcome", choices=["success", "failure", "unknown"])
    p_obs_done.add_argument("--log-excerpt", default="")
    p_obs_done.add_argument("--log-file")
    p_obs_done.add_argument("--log-lines", type=int, default=40)
    p_obs_done.add_argument("--project", metavar="NAME")
    p_obs_done.add_argument("--task-id", metavar="TASK_ID")
    p_obs_done.add_argument("--attach-file", metavar="PATH", help="Attach report file to outbox after recording outcome")
    p_obs_done.add_argument("--attach-text", help="Attach inline report text to outbox after recording outcome")
    p_obs_done.add_argument("--attach-title", default="", help="Title for attach artifact")
    p_obs_done.set_defaults(func=observe_session_cmd, observe_session_action="complete")
    p_obs_watch = p_obs_sub.add_parser("watch", help="Tail log file and complete session on exit or stability")
    p_obs_watch.add_argument("--log-file", required=True, help="Log file to tail and attach on complete")
    p_obs_watch.add_argument("--agent", default="hermes")
    p_obs_watch.add_argument("--agent-name", help="Alias for --agent")
    p_obs_watch.add_argument("--project", metavar="NAME")
    p_obs_watch.add_argument("--task-id", metavar="TASK_ID")
    p_obs_watch.add_argument("--marker-file", help="Optional marker file; contents may be exit code")
    p_obs_watch.add_argument("--pid", type=int, help="Optional process PID to watch for exit")
    p_obs_watch.add_argument("--stable-seconds", type=float, default=8.0, help="Log mtime/size stable window")
    p_obs_watch.add_argument("--timeout", type=float, default=None, help="Max watch duration in seconds")
    p_obs_watch.set_defaults(func=observe_session_cmd, observe_session_action="watch")

    p_vq = sub.add_parser("venture-queue", help="Lightweight cross-project venture queue")
    p_vq_sub = p_vq.add_subparsers(dest="venture_queue_action", required=True)
    p_vq_list = p_vq_sub.add_parser("list")
    p_vq_list.set_defaults(func=venture_queue_cmd)
    p_vq_add = p_vq_sub.add_parser("add", help="Enqueue a venture")
    p_vq_add.add_argument("--project", required=True)
    p_vq_add.add_argument("--task-id", required=True)
    p_vq_add.add_argument("--agent", default="hermes")
    p_vq_add.add_argument("--pattern", default="")
    p_vq_add.add_argument("--engine", default="")
    p_vq_add.add_argument("--priority", type=int, default=50)
    p_vq_add.set_defaults(func=venture_queue_cmd)
    p_vq_next = p_vq_sub.add_parser("next", help="Next pending item if capacity allows")
    p_vq_next.add_argument(
        "--spawn",
        action="store_true",
        help="Spawn tmux/wezterm session when TERMINAL_BRIDGE allows (also LIAISON_AUTO_SPAWN=1)",
    )
    p_vq_next.set_defaults(func=venture_queue_cmd, venture_queue_action="next")
    p_vq_mr = p_vq_sub.add_parser("mark-running")
    p_vq_mr.add_argument("item_id")
    p_vq_mr.set_defaults(func=venture_queue_cmd, venture_queue_action="mark-running")
    p_vq_md = p_vq_sub.add_parser("mark-done")
    p_vq_md.add_argument("item_id")
    p_vq_md.set_defaults(func=venture_queue_cmd, venture_queue_action="mark-done")
    p_vq_cancel = p_vq_sub.add_parser("cancel")
    p_vq_cancel.add_argument("item_id")
    p_vq_cancel.set_defaults(func=venture_queue_cmd, venture_queue_action="cancel")

    p = sub.add_parser("dashboard")
    p.add_argument("--show", action="store_true")
    p.set_defaults(func=dashboard_cmd)

    p = sub.add_parser("gate")
    p.add_argument("--show", action="store_true")
    p.add_argument("--production", action="store_true", help="Include MVP production-readiness checks")
    p.set_defaults(func=gate_cmd)

    p = sub.add_parser("drift-check")
    p.add_argument("--show", action="store_true")
    p.add_argument("--fail-on-findings", action="store_true")
    p.set_defaults(func=drift_check_cmd)

    p = sub.add_parser("promote-learning")
    p.add_argument("--tags")
    p.set_defaults(func=promote_learning_cmd)

    p = sub.add_parser("memory-report")
    p.add_argument("--limit", type=int, default=20)
    p.set_defaults(func=memory_report_cmd)

    p = sub.add_parser("registry")
    p.add_argument("registry_name", choices=["repos", "agents", "skills", "workflows", "artifact-contracts", "phase-routing", "hub-skills", "rolodex", "evaluations"])
    p.set_defaults(func=registry_cmd)

    args = parser.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
