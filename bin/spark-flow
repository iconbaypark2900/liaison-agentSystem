    result = watch_session(
        log_file=log_file,
        agent=getattr(args, "agent", None) or getattr(args, "agent_name", None) or "hermes",
        project_key=getattr(args, "project", None) or "",
        task_id=getattr(args, "task_id", None) or "",
        marker_file=Path(marker) if marker else None,
        pid=getattr(args, "pid", None),
        stable_seconds=float(getattr(args, "stable_seconds", 8)),
        timeout=getattr(args, "timeout", None),
    )
    print(json.dumps(result, indent=2))


def venture_queue_cmd(args: argparse.Namespace) -> None:
    root = str(AGENT_SYSTEM_DIR)
    if root not in sys.path:
        sys.path.insert(0, root)
    from dashboard.command_center.terminal_sessions import list_sessions
    from dashboard.command_center import venture_queue as vq

    action = getattr(args, "venture_queue_action", "list")
    sessions = list_sessions()
    if action == "list":
        print(json.dumps({"items": vq.list_items(), "summary": vq.build_queue_summary(sessions)}))
        return
    if action == "add":
        item = vq.add_item(
            project_key=args.project,
            task_id=args.task_id,
            agent=getattr(args, "agent", "hermes") or "hermes",
            pattern_id=getattr(args, "pattern", "") or "",
            engine=getattr(args, "engine", "") or "",
            priority=getattr(args, "priority", 50),
        )
        print(json.dumps(item))
        return
    if action == "next":
        spawn = getattr(args, "spawn", False) or os.environ.get("LIAISON_AUTO_SPAWN", "").strip() in (
            "1",
            "true",
            "yes",
        )
        item, msg, hints = vq.pick_next(sessions, spawn=spawn)
        print(json.dumps({"item": item, "message": msg, "hints": hints, "spawned": bool(hints.get("spawn_result", {}).get("spawned"))}))
        return
    if action == "mark-running":
        item = vq.mark_running(args.item_id)
        if not item:
            die(f"Queue item not found: {args.item_id}")
        print(json.dumps(item))
        return
    if action == "mark-done":
        item = vq.mark_done(args.item_id)
        if not item:
            die(f"Queue item not found: {args.item_id}")
        print(json.dumps(item))
        return
    if action == "cancel":
        item = vq.cancel_item(args.item_id)
        if not item:
            die(f"Queue item not found: {args.item_id}")
        print(json.dumps(item))
        return
    die("Unknown venture-queue action")


def look_cmd(args: argparse.Namespace) -> None:
    state = collect_look_state(args.refresh)
    if args.interactive:
        if not sys.stdin.isatty():
            print_look_view(state)
            print("Interactive look needs a TTY; printed snapshot instead.")
            return
        while True:
            if sys.stdout.isatty():
                print("\033c", end="")
            print_look_view(state)
            command = input("look> ").strip().lower()
            if command in {"q", "quit", "exit"}:
                print("Look closed.")
                return
            if command in {"r", "refresh"}:
                state = collect_look_state(True)
                continue
            print("Commands: r=refresh, q=quit")
        return
    print_look_view(state)


def control_panel_state(refresh: bool = False) -> tuple[dict, list[dict]]:
    if refresh or not latest_recommendations(1):
        refresh_recommendation_memory(6)
    return repo_context_evidence(), latest_recommendations(6)


def print_control_panel(evidence: dict, options: list[dict], interactive: bool = False) -> None:
    print("Liaison Control Panel")
    print(f"Project: {infer_project_summary(evidence)}")
    print(f"Repo: {evidence['repo']}")
    print(f"Memory loaded: {'yes' if repo_memory_dir().exists() else 'no'}")
    print(f"Git status: {evidence['git_status'] or 'clean'}")
    print()
    print("Recommended next choices:")
    for idx, option in enumerate(options, 1):
        marker = "*" if option["kind"] == "recommended" else " "
        print(f"{marker} [{idx}] {option['label']} ({option['kind']}, score {option['score']})")
    print()
    if interactive:
        print("Commands: number=details, c<number>=choose, r=refresh, q=quit")
    else:
        print(f"Use `{CLI_NAME} control-panel --interactive` for selection, or `{CLI_NAME} choose <number> --show` to record a path.")


def print_option_detail(option: dict) -> None:
    print(f"{option['label']} ({option['kind']}, score {option['score']})")
    print(f"Why: {option['why']}")
    print(f"Agents: {', '.join(option['agents'])}")
    print("Steps:")
    for idx, step in enumerate(option["steps"], 1):
        print(f"  {idx}. {step}")
    print(f"Pivot: {option['pivot']}")


def interactive_control_panel(refresh: bool = False) -> None:
    evidence, options = control_panel_state(refresh)
    while True:
        if sys.stdout.isatty():
            print("\033c", end="")
        print_control_panel(evidence, options, interactive=True)
        command = input("panel> ").strip()
        if command in {"q", "quit", "exit"}:
            print("Panel closed.")
            return
        if command in {"r", "refresh"}:
            evidence, options = control_panel_state(True)
            continue
        if command in {"h", "help", "?"}:
            print("Enter 1-6 to inspect, c1-c6 to choose, r to refresh, q to quit.")
            input("Press Enter to continue...")
            continue
        choose_now = command.startswith("c") and command[1:].isdigit()
        value = command[1:] if choose_now else command
        selected = select_recommendation(options, value)
        if selected is None:
            print("Unknown command. Enter h for help.")
            input("Press Enter to continue...")
            continue
        if choose_now:
            record_choice(selected, "Operator selected this path from the interactive control panel.", show=True)
            return
        print()
        print_option_detail(selected)
        followup = input("Choose this option? [y/N] ").strip().lower()
        if followup in {"y", "yes"}:
            record_choice(selected, "Operator selected this path from the interactive control panel.", show=True)
            return


def control_panel_cmd(args: argparse.Namespace) -> None:
    if args.interactive:
        if not sys.stdin.isatty():
            evidence, options = control_panel_state(args.refresh)
            print_control_panel(evidence, options, interactive=False)
            print("Interactive mode needs a TTY; printed the panel instead.")
            return
        interactive_control_panel(args.refresh)
        return
    evidence, options = control_panel_state(args.refresh)
    print_control_panel(evidence, options, interactive=False)

def dashboard_cmd(args: argparse.Namespace) -> None:
    tasks = build_task_index(None)
    write_task_index(tasks)
    discovery = discover_projects(None)
    write_project_discovery(discovery)
    next_work = build_next_work(discovery, 10)
    write_next_work(discovery, next_work)
    trends = build_trends(None)
    dashboard_dir = AGENT_SYSTEM_DIR / "dashboard"
    dashboard_dir.mkdir(exist_ok=True)
    total = len(tasks)
    closed = sum(1 for item in tasks if item["closed"])
    open_count = total - closed
    gate_fail = sum(1 for item in tasks if item["gate_status"] == "fail")
    unscored = sum(1 for item in tasks if item["score_status"] == "missing")
    lines = ["# DASHBOARD", "", f"Generated: {now()}", "", "## Task Summary", "", f"- Total tasks: {total}", f"- Open tasks: {open_count}", f"- Closed tasks: {closed}", f"- Gate failures: {gate_fail}", f"- Tasks missing scores: {unscored}", f"- Promoted learnings: {trends['learning_count']}", f"- Trend warnings: {len(trends['candidate_improvements'])}", f"- Projects discovered: {discovery['project_count']}", f"- Generated next-work items: {len(next_work)}", "", "## Attention", ""]
    attention = []
    if gate_fail:
        attention.append(f"{gate_fail} task(s) have failing gates.")
    if unscored:
        attention.append(f"{unscored} task(s) do not have artifact scores yet.")
    attention.extend(item["candidate_improvement"] for item in trends["candidate_improvements"][:10])
    lines.extend([f"- {item}" for item in attention] or ["- No dashboard warnings."])
    lines.extend(["", "## References", "", "- `dashboard/TASK_INDEX.md`", "- `dashboard/tasks.json`", "- `dashboard/PROJECTS.md`", "- `dashboard/projects.json`", "- `dashboard/NEXT_WORK.md`", "- `dashboard/next_work.json`", "- `memory/TREND_REPORT.md`", "- `memory/trends.json`"])
    target = dashboard_dir / "DASHBOARD.md"
    target.write_text("\n".join(lines) + "\n")
    write_json(dashboard_dir / "dashboard.json", {"generated_at": now(), "summary": {"total_tasks": total, "open_tasks": open_count, "closed_tasks": closed, "gate_failures": gate_fail, "unscored_tasks": unscored, "promoted_learnings": trends["learning_count"], "trend_warnings": len(trends["candidate_improvements"]), "projects_discovered": discovery["project_count"], "next_work_items": len(next_work)} })
    if args.show:
        print(target.read_text())
    print(f"Dashboard written to: {target}")

def has_passing_validation(td: Path) -> bool:
    outbox = td / "outbox"
    if outbox.exists():
        for path in outbox.glob("test.*.md"):
            text = path.read_text(errors="replace")
            if "## Status" in text and "pass" in text.split("## Status", 1)[1][:40].lower():
                return True
    validation = td / "VALIDATION.md"
    if validation.exists() and "(pass)" in validation.read_text(errors="replace"):
        return True
    return False


def production_readiness_checks(td: Path) -> list[tuple[str, bool, str]]:
    checks: list[tuple[str, bool, str]] = []
    deploy_doc = False
    for candidate in [Path("DEPLOY.md"), Path("docs/DEPLOY.md"), Path("README.md")]:
        if candidate.exists() and re.search(r"deploy|rollback", candidate.read_text(errors="replace"), re.I):
            deploy_doc = True
            break
    closeout = td / "CLOSEOUT.md"
    if closeout.exists() and re.search(r"deploy|rollback", closeout.read_text(errors="replace"), re.I):
        deploy_doc = True
    checks.append(("deploy_documented", deploy_doc, "Document deploy and rollback in DEPLOY.md, README, or the closeout summary."))
    secrets_clean = True
    try:
        tracked = capture(["git", "ls-files"]).splitlines()
        secrets_clean = not any(
            re.search(r"(^|/)\.env($|\.)|(^|/)secrets?\.(json|ya?ml)$", entry) and not entry.endswith(".example")
            for entry in tracked
        )
    except Exception:
        secrets_clean = True
    checks.append(("secrets_clean", secrets_clean, "Remove tracked secrets (.env, secrets.*) before MVP."))
    checks.append(("validation_pass", has_passing_validation(td), f"Record a passing validation with `{CLI_NAME} validate`."))
    return checks


def load_evaluation_rubrics() -> dict[str, dict[str, str]]:
    path = AGENT_SYSTEM_DIR / "registry" / "evaluations.yaml"
    rubrics: dict[str, dict[str, str]] = {}
    if not path.exists():
        return rubrics
    current: str | None = None
    for line in path.read_text(errors="replace").splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped == "evaluation_rubrics:":
            continue
        if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
            current = stripped[:-1]
            rubrics[current] = {}
        elif current and line.startswith("    ") and ":" in stripped:
            key, value = stripped.split(":", 1)
            rubrics[current][key.strip()] = value.strip().strip('"\'')
    return rubrics


def load_feedback_success_conditions() -> list[str]:
    path = AGENT_SYSTEM_DIR / "evaluations" / "closed-feedback-loop.yaml"
    if not path.exists():
        return []
    conditions: list[str] = []
    in_block = False
    for line in path.read_text(errors="replace").splitlines():
        stripped = line.strip()
        if stripped == "success_conditions:":
            in_block = True
            continue
        if in_block:
            if stripped.startswith("- "):
                conditions.append(stripped[2:].strip())
            elif stripped and not line.startswith(" "):
                break
    return conditions


def gate_checks(include_production: bool = False) -> list[tuple[str, bool, str]]:
    td = task_dir()
    checks = []
    checks.append(("objective", (td / "OBJECTIVES.md").exists() and count_meaningful_entries(td / "OBJECTIVES.md", "## Objective:") > 0, "Record at least one explicit objective with `spark-flow objective`."))
    checks.append(("context", (td / "CONTEXT.md").exists() and "Snapshot" in (td / "CONTEXT.md").read_text(errors="replace"), "Run `spark-flow snapshot`."))
    checks.append(("observation", count_meaningful_entries(td / "OBSERVATIONS.md", "## ") > 0, "Record at least one observation with `spark-flow observe`."))
    checks.append(("evaluation", count_meaningful_entries(td / "EVALUATIONS.md", "## Evaluation:") > 0, "Record at least one evaluation with `spark-flow evaluate`."))
    checks.append(("approved_or_rejected", any((td / name).exists() and list((td / name).glob("*.md")) for name in ["approved", "rejected"]), "Approve or reject at least one artifact."))

    eval_text = (td / "EVALUATIONS.md").read_text(errors="replace") if (td / "EVALUATIONS.md").exists() else ""
    has_failed_eval = "- Status: fail" in eval_text
    has_learning = count_meaningful_entries(td / "LEARNINGS.md", "## Learning:") > 0
    has_improvement = count_meaningful_entries(td / "IMPROVEMENTS.md", "## Improvement:") > 0
    checks.append(("failed_eval_learning", (not has_failed_eval) or has_learning, "Failed evaluations require `spark-flow learn`."))
    checks.append(("learning_improvement", (not has_learning) or has_improvement, "Learnings should create an improvement with `spark-flow improve`."))
    checks.append(("feedback_cycle", (td / "FEEDBACK_LOOP.md").exists() and "Antifragile review questions" in (td / "FEEDBACK_LOOP.md").read_text(errors="replace"), "Run `spark-flow feedback-cycle`."))
    scores_file = td / "SCORES.md"
    score_ok = True
    score_fix = "Run `spark-flow score-artifacts --show` before closeout for deterministic artifact scoring."
    if scores_file.exists():
        score_ok = "Average score:" in scores_file.read_text(errors="replace")
        score_fix = "Regenerate malformed scores with `spark-flow score-artifacts --show`."
    checks.append(("artifact_scores", score_ok, score_fix))
    if include_production:
        checks.extend(production_readiness_checks(td))
    return checks


def write_gate_report(checks: list[tuple[str, bool, str]]) -> tuple[Path, list[str]]:
    lines = [f"# GATE REPORT: {current_task_id()}", "", f"Generated: {now()}", ""]
    failed = []
    for name, ok, fix in checks:
        status = "PASS" if ok else "FAIL"
        lines.append(f"- {status}: {name}")
        if name == "artifact_scores" and ok and not (task_dir() / "SCORES.md").exists():
            lines.append("  - Recommendation: Run `spark-flow score-artifacts --show` before closeout for deterministic artifact scoring.")
        if not ok:
            lines.append(f"  - Fix: {fix}")
            failed.append(name)
    success_conditions = load_feedback_success_conditions()
    if success_conditions:
        lines.extend(["", "## Closed-feedback success conditions", ""])
        lines.extend(f"- {condition}" for condition in success_conditions)
    target = task_dir() / "GATE_REPORT.md"
    target.write_text("\n".join(lines) + "\n")
    return target, failed


def gate_cmd(args: argparse.Namespace) -> None:
    include_production = getattr(args, "production", False) or get_project_phase() == "mvp"
    checks = gate_checks(include_production=include_production)
    target, failed = write_gate_report(checks)
    append_event("gate", command="gate", details={"failed": failed, "target": str(target), "production": include_production})
    if args.show:
        print(target.read_text())
    if failed:
        print(f"Gate failed: {', '.join(failed)}")
        raise SystemExit(1)
    print("Gate passed.")


def drift_check_cmd(args: argparse.Namespace) -> None:
    td = task_dir()
    objective_text = (td / "OBJECTIVES.md").read_text(errors="replace") if (td / "OBJECTIVES.md").exists() else ""
    approvals_text = (td / "APPROVALS.md").read_text(errors="replace") if (td / "APPROVALS.md").exists() else ""
    decisions_text = (td / "DECISIONS.md").read_text(errors="replace") if (td / "DECISIONS.md").exists() else ""
    outbox_count = len(list((td / "outbox").glob("*.md"))) if (td / "outbox").exists() else 0
    approved_count = len(list((td / "approved").glob("*.md"))) if (td / "approved").exists() else 0

    findings = []
    if "## Objective:" not in objective_text:
        findings.append("No explicit objective beyond the initial task description.")
    if outbox_count and not approved_count:
        findings.append("Artifacts exist in outbox but none have been approved.")
    if approved_count and "## Decision:" not in decisions_text:
        findings.append("Approved artifacts exist without a durable decision record.")
    if approved_count and "Approved:" not in approvals_text:
        findings.append("Approved artifact files exist but APPROVALS.md lacks approval entries.")
    if not findings:
        findings.append("No obvious objective drift detected by deterministic checks.")

    report = dedent(f"""\
        # DRIFT CHECK: {current_task_id()}

        Generated: {now()}

        ## Findings

        {chr(10).join(f"- {item}" for item in findings)}

        ## Limits

        This is a deterministic drift check. Use `spark-flow evaluate --rubric alignment` for judgment-based assessment.
        """)
    target = td / "DRIFT_CHECK.md"
    target.write_text(report)
    append_event("drift-check", command="drift-check", details={"target": str(target), "findings": findings})
    if args.show:
        print(report)
    if args.fail_on_findings and findings != ["No obvious objective drift detected by deterministic checks."]:
        raise SystemExit(1)
    print(f"Drift check written to: {target}")


def promote_learning_cmd(args: argparse.Namespace) -> None:
    td = task_dir()
    learnings = td / "LEARNINGS.md"
    if not learnings.exists():
        die("No LEARNINGS.md found for current task")
    destination_dir = AGENT_SYSTEM_DIR / "memory"
    destination_dir.mkdir(exist_ok=True)
    destination = destination_dir / f"{current_task_id()}.learning.md"
    content = dedent(f"""\
        # Promoted learning: {current_task_id()}

        - Promoted at: {now()}
        - Source repo: `{Path.cwd()}`
        - Source task: `{td}`
        - Tags: {args.tags or 'none'}

        ## Learning source

        {learnings.read_text(errors='replace')}
        """)
    destination.write_text(content)
    append_event("promote-learning", command="promote-learning", details={"destination": str(destination), "tags": args.tags})
    print(f"Learning promoted to: {destination}")


def memory_report_cmd(args: argparse.Namespace) -> None:
    memory_dir = AGENT_SYSTEM_DIR / "memory"
    files = sorted(memory_dir.glob("*.learning.md")) if memory_dir.exists() else []
    lines = ["# MEMORY REPORT", "", f"Generated: {now()}", "", f"Promoted learnings: {len(files)}", ""]
    for path in files[-args.limit:]:
        text = path.read_text(errors="replace").splitlines()
        title = text[0] if text else path.name
        lines.append(f"- `{path.name}`: {title.lstrip('# ').strip()}")
    report = "\n".join(lines) + "\n"
    print(report)


def registry_cmd(args: argparse.Namespace) -> None:
    allowed = {"repos", "agents", "skills", "workflows", "artifact-contracts", "phase-routing", "hub-skills", "rolodex", "evaluations"}
    if args.registry_name not in allowed:
        die(f"Unknown registry: {args.registry_name}")
    filename = args.registry_name.replace("-", "_") + ".yaml"
    path = AGENT_SYSTEM_DIR / "registry" / filename
    if not path.exists():
        die(f"Missing registry file: {path}")
    print(path.read_text())


def available_workflows() -> set[str]:
    names: set[str] = set()
    workflows_dir = AGENT_SYSTEM_DIR / "workflows"
    if workflows_dir.exists():
        for path in workflows_dir.glob("*.yaml"):
            names.add(path.stem)
    registry = AGENT_SYSTEM_DIR / "registry" / "workflows.yaml"
    if registry.exists():
        for line in registry.read_text(errors="replace").splitlines():
            stripped = line.strip()
            if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
                names.add(stripped[:-1])
    return names


def annotate_workflow(task_id: str, workflow: str) -> None:
    brief = task_dir(task_id) / "BRIEF.md"
    if brief.exists():
        append_markdown(
            brief,
            f"\n## Workflow\n\n- Selected workflow: `{workflow}`\n"
            f"- Resolve skills: `{CLI_NAME} skills-for {workflow} plan`\n"
            f"- Workflow definitions: `{CLI_NAME} workflows`\n",
        )


def create_task(task_id: str, description: str, workflow: str | None = None) -> Path:
    ensure_dirs()
    td = task_dir(task_id)
    if td.exists():
        die(f"Task already exists: {task_id}")

    CURRENT_FILE.parent.mkdir(parents=True, exist_ok=True)
    CURRENT_FILE.write_text(task_id)

    td.mkdir(parents=True)
    state = {
        "TASK_ID": task_id,
        "DESCRIPTION": description,
        "CURRENT_PHASE": "plan",
        "CREATED_AT": now(),
        "UPDATED_AT": now(),
        "APPROVED_PLAN": "0",
        "APPROVED_BUILD": "0",
        "APPROVED_PATCH": "0",
        "APPROVED_REVIEW": "0",
        "APPROVED_CLOSE": "0",
    }
    if workflow:
        state["WORKFLOW"] = workflow
    write_state(state, task_id)
    write_task_files(task_id, description)
    write_reporter_files(task_id, description)
    if workflow:
        annotate_workflow(task_id, workflow)
    return td


def init(args: argparse.Namespace) -> None:
    workflow = getattr(args, "workflow", None)
    if workflow:
        known = available_workflows()
        if known and workflow not in known:
            die(f"Unknown workflow '{workflow}'. Known workflows: {', '.join(sorted(known))}")
    td = create_task(args.task_id, args.description, workflow)

    print(f"Initialized task: {args.task_id}")
    print(f"Task dir: {td}")
    if workflow:
        print(f"Workflow: {workflow}")
    print(f"Next: {CLI_NAME} snapshot --show")
    print(f"Optional executor lane: {CLI_NAME} start plan")


def parse_project_agent_patterns() -> list[dict]:
    """Parse project_agent_patterns from registry/hub_skills.yaml."""
    path = AGENT_SYSTEM_DIR / "registry" / "hub_skills.yaml"
    patterns: list[dict] = []
    if not path.exists():
        return patterns
    in_block = False
    current: dict | None = None
    in_steps = False
    for raw in path.read_text(errors="replace").splitlines():
        stripped = raw.strip()
        if stripped == "project_agent_patterns:":
            in_block = True
            continue
        if not in_block:
            continue
        if not raw.startswith(" ") and stripped.endswith(":"):
            break
        if raw.startswith("  - ") and "id:" in stripped:
            if current:
                patterns.append(current)
            current = {"id": stripped.split("id:", 1)[1].strip(), "steps": []}
            in_steps = False
        elif current and stripped == "steps:":
            in_steps = True
        elif current and in_steps and raw.startswith("      - "):
            current["steps"].append(stripped[2:].strip().strip('"\''))
        elif current and ":" in stripped and not stripped.startswith("- "):
            key, value = stripped.split(":", 1)
            key = key.strip()
            value = value.strip()
            if key in ("agents", "specialists"):
                current[key] = [item.strip() for item in value.strip("[]").split(",") if item.strip()]
            else:
                current[key] = value.strip('"\'')
            in_steps = False
    if current:
        patterns.append(current)
    return patterns


def pattern_agent_chain(pattern: dict) -> list[str]:
    agents = list(pattern.get("agents", []))
    for specialist in pattern.get("specialists", []):
        if specialist not in agents:
            agents.append(specialist)
    return agents


def start_pattern_cmd(args: argparse.Namespace) -> None:
    patterns = parse_project_agent_patterns()
    if args.list or not args.pattern_id:
        if not patterns:
            print("No multi-agent patterns found in registry/hub_skills.yaml.")
            return
        print("Available multi-agent project patterns:")
        for pattern in patterns:
            chain = " -> ".join(pattern_agent_chain(pattern)) or "(no agents)"
            print(f"- {pattern['id']}: {pattern.get('label', pattern['id'])}")
            print(f"    chain: {chain}")
        print(f"\nStart one with: {CLI_NAME} start-pattern <id>")
        return
    pattern = next((item for item in patterns if item["id"] == args.pattern_id), None)
    if not pattern:
        die(f"Unknown pattern '{args.pattern_id}'. Run `{CLI_NAME} start-pattern --list`.")
    chain = pattern_agent_chain(pattern)
    task_id = args.task_id or f"{args.pattern_id}-{datetime.now().strftime('%H%M%S')}"
    description = args.description or pattern.get("label", args.pattern_id)
    create_task(task_id, description)
    td = task_dir(task_id)
    brief_lines = [
        "",
        "## Multi-agent pattern",
        "",
        f"- Pattern: `{pattern['id']}` — {pattern.get('label', '')}",
        f"- When: {pattern.get('when', '')}",
        f"- Agent chain: {' -> '.join(chain) or '(none)'}",
        "",
        "### Expected outbox artifacts",
        "",
    ]
    for agent in chain:
        brief_lines.append(f"- `{agent}` report → attach with `{CLI_NAME} attach {agent} --file <report.md>`")
    brief_lines.extend(["", "### Steps", ""])
    for idx, step in enumerate(pattern.get("steps", []), 1):
        brief_lines.append(f"{idx}. {step}")
    brief_lines.extend(["", "### Handoff checklist", ""])
    for agent in chain:
        brief_lines.append(f"- [ ] {agent} report attached, reviewed, and approved")
    append_markdown(td / "BRIEF.md", "\n".join(brief_lines) + "\n")
    append_markdown(td / "HANDOFFS.md", f"\n## Pattern: {pattern['id']}\n\nChain: {' -> '.join(chain)}\n")
    print(f"Started pattern '{pattern['id']}' as task: {task_id}")
    print(f"Agent chain: {' -> '.join(chain)}")
    if chain:
        print(f"Next: produce the {chain[0]} report, then `{CLI_NAME} attach {chain[0]} --file <report.md>`")


def phase_prompt(phase: str) -> str:
    if phase not in ROUTES:
        die(f"Unknown phase: {phase}")

    tid = current_task_id()
    td = task_dir(tid)
    state = read_state(tid)
    route = ROUTES[phase]

    previous_context = ""
    approved_files = sorted((td / "approved").glob("*.md"))
    if approved_files:
        previous_context = "\n".join(f"- {p}" for p in approved_files)
    else:
        previous_context = "- No approved prior phase outputs yet."

    feedback_file = td / "feedback" / f"{phase}.md"
    feedback = feedback_file.read_text() if feedback_file.exists() else "No human rejection feedback for this phase."

    outbox_file = td / "outbox" / f"{phase}.md"

    phase_specific = {
        "plan": dedent("""\
            ## Phase objective: PLAN

            Do not edit project source files.

            Produce a scoped handoff for BUILD.

            Required output sections:
            1. Current repo state
            2. Smallest useful vertical slice
            3. Allowed files
            4. Forbidden files/directories
            5. Acceptance criteria
            6. Test plan
            7. Risks
            8. Exact BUILD prompt for Qwen3-Coder

            Do not add unrequested tools like flake8, coverage thresholds, or commit requirements.
            """),
        "build": dedent("""\
            ## Phase objective: BUILD

            Implement the approved handoff only.

            Rules:
            1. Inspect files first.
            2. Touch only allowed files from the approved PLAN handoff.
            3. Add or update tests.
            4. Do not install dependencies.
            5. Do not add unapproved tools.
            6. Show validation commands.
            """),
        "patch": dedent("""\
            ## Phase objective: PATCH

            Apply a minimal corrective patch.

            Use only for:
            - failing tests
            - human rejection feedback
            - review-requested changes

            Do not redesign.
            """),
        "review": dedent("""\
            ## Phase objective: REVIEW

            Do not edit files.

            Review against:
            - PROJECT_SPEC.md
            - AGENTS.md
            - approved PLAN
            - approved BUILD notes
            - current git diff

            Output:
            1. Verdict: approve / approve with changes / reject
            2. Top issues
            3. Missing tests
            4. Minimal PATCH prompt if needed
            """),
        "close": dedent("""\
            ## Phase objective: CLOSE

            Finish the task thread.

            Actions:
            1. Summarize final state
            2. Update docs only if needed
            3. List validation commands/results
            4. Produce ready-to-commit message

            Do not start a new feature.
            """),
    }[phase]

    return dedent(f"""\
        # spark-flow prompt: {phase}

        ## Task

        {state["DESCRIPTION"]}

        ## Agent

        {route["agent"]}

        ## Model

        {route["model"]}

        ## Role

        {route["role"]}

        ## Required reading

        1. AGENTS.md, if present
        2. CLAUDE.md, if present
        3. PROMPTS.md, if present
        4. {td}/TASK.md
        5. {td}/CHECKS.md
        6. Approved prior outputs listed below

        ## Approved prior phase outputs

        {previous_context}

        ## Human feedback for this phase

        {feedback}

        {phase_specific}

        ## Mandatory output file

        Write your final phase result to:

        {outbox_file}

        The human will review this file before the next model receives it.

        ## Global rules

        - Keep the work scoped to this task.
        - Do not delete unrelated files.
        - Do not install dependencies unless explicitly approved.
        - Do not call external services unless explicitly required.
        - Show changed files and validation commands.
        - If the output is a plan or review, do not edit source files.
        """)


def write_prompt(phase: str) -> Path:
    tid = current_task_id()
    td = task_dir(tid)
    prompt_file = td / "prompts" / f"{phase}.md"
    prompt_file.write_text(phase_prompt(phase))
    return prompt_file


def start(args: argparse.Namespace) -> None:
    phase = args.phase
    if phase not in ROUTES:
        die(f"Unknown phase: {phase}")

    require_cmd("ollama")
    require_cmd("curl")
    require_cmd(ROUTES[phase]["agent"])

    if not ollama_alive():
        die("Ollama API is not reachable at http://127.0.0.1:11434")

    tid = current_task_id()
    state = read_state(tid)
    state["CURRENT_PHASE"] = phase
    state["UPDATED_AT"] = now()
    write_state(state, tid)

    prompt_file = write_prompt(phase)
    route = ROUTES[phase]

    stop_models()

    print()
    print(f"Starting phase: {phase}")
    print(f"Agent: {route['agent']}")
    print(f"Model: {route['model']}")
    print(f"Prompt file: {prompt_file}")
    print()
    print("Inside the agent, paste:")
    print(f"Read the prompt file at: {Path.cwd() / prompt_file}")
    print()
    print("The agent must write its result to:")
    print(Path.cwd() / task_dir(tid) / "outbox" / f"{phase}.md")
    print()

    run(["ollama", "launch", route["agent"], "--model", route["model"]])


def approve(args: argparse.Namespace) -> None:
    phase = args.phase
    if phase not in ROUTES:
        die(f"Unknown phase: {phase}")

    tid = current_task_id()
    td = task_dir(tid)
    outbox = td / "outbox" / f"{phase}.md"
    if not outbox.exists():
        die(f"Missing agent output: {outbox}")

    approved = td / "approved" / f"{phase}.md"
    shutil.copyfile(outbox, approved)

    next_phase = ROUTES[phase]["next"]
    if next_phase:
        handoff = td / "handoff" / f"{next_phase}.md"
        handoff.write_text(dedent(f"""\
            # HANDOFF for {next_phase}

            This handoff was human-approved from phase: {phase}

            Approved source:

            {approved}

            ## Approved content

            {approved.read_text()}
            """))

    state = read_state(tid)
    state[f"APPROVED_{phase.upper()}"] = "1"
    state["CURRENT_PHASE"] = next_phase or "complete"
    state["UPDATED_AT"] = now()
    write_state(state, tid)

    print(f"Approved phase: {phase}")
    if next_phase:
        print(f"Next: {CLI_NAME} start {next_phase}")
    else:
        print("Workflow complete. Review git diff and commit manually.")


def reject(args: argparse.Namespace) -> None:
    phase = args.phase
    if phase not in ROUTES:
        die(f"Unknown phase: {phase}")

    tid = current_task_id()
    td = task_dir(tid)
    feedback = td / "feedback" / f"{phase}.md"
    feedback.write_text(dedent(f"""\
        # Human rejection feedback for {phase}

        {args.reason}

        ## Next action

        Re-run:

        spark-flow start {phase}
        """))

    state = read_state(tid)
    state[f"APPROVED_{phase.upper()}"] = "0"
    state["CURRENT_PHASE"] = phase
    state["UPDATED_AT"] = now()
    write_state(state, tid)

    print(f"Rejected phase: {phase}")
    print(f"Feedback written to: {feedback}")
    print(f"Next: {CLI_NAME} start {phase}")


def status(_: argparse.Namespace) -> None:
    tid = current_task_id()
    state = read_state(tid)
    td = task_dir(tid)

    print(f"Task: {state.get('TASK_ID')}")
    print(f"Description: {state.get('DESCRIPTION')}")
    print(f"Current phase: {state.get('CURRENT_PHASE')}")
    print(f"Task dir: {td}")
    print()
    print("Approvals:")
    for phase in PHASES:
        print(f"  {phase}: {state.get('APPROVED_' + phase.upper(), '0')}")
    print()
    print("Git status:")
    print(git_status() or "  clean")
    print()
    print("Ollama loaded models:")
    subprocess.run(["ollama", "ps"], check=False)


def doctor(_: argparse.Namespace) -> None:
    print("Commands:")
    for cmd in ["ollama", "curl", "git", "claude", "opencode", "codex"]:
        found = shutil.which(cmd)
        print(f"  {cmd}: {found or 'MISSING'}")

    print()
    print("Ollama API:")
    print("  OK" if ollama_alive() else "  FAIL")

    print()
    print("Installed models:")
    subprocess.run(["ollama", "list"], check=False)

    print()
    print("Loaded models:")
    subprocess.run(["ollama", "ps"], check=False)


def stop(_: argparse.Namespace) -> None:
    stop_models()


# ---------------------------------------------------------------------
# Phase 6 control-plane commands (AGENT_SYSTEM_DIR imported at top)
# ---------------------------------------------------------------------


def read_text_if_exists(path: Path) -> str:
    if not path.exists():
        return ""
    return path.read_text()


def list_yaml_files(directory: Path) -> list[Path]:
    if not directory.exists():
        return []
    return sorted(list(directory.glob("*.yaml")) + list(directory.glob("*.yml")))


def extract_yaml_blocks(text: str, parent_key: str) -> dict[str, str]:
    """Small YAML-block extractor for our simple control-plane config files.

    This is not a full YAML parser. It is intentionally dependency-free and
    handles the simple layout used in $LIAISON_ROOT/config/model_routes.yaml.
    """
    lines = text.splitlines()
    blocks: dict[str, list[str]] = {}
    in_parent = False
    current_key: str | None = None

    for line in lines:
        stripped = line.strip()

        if not stripped or stripped.startswith("#"):
            continue

        if line.startswith(parent_key + ":"):
            in_parent = True
            current_key = None
            continue

        if in_parent:
            if line and not line.startswith(" ") and stripped.endswith(":"):
                break

            if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
                current_key = stripped[:-1]
                blocks[current_key] = []
                continue

            if current_key:
                blocks[current_key].append(line)

    return {key: "\n".join(value) for key, value in blocks.items()}


def block_field(block: str, field: str) -> str:
    for line in block.splitlines():
        stripped = line.strip()
        if stripped.startswith(field + ":"):
            return stripped.split(":", 1)[1].strip()
    return ""


def block_list_values(block: str, field: str) -> list[str]:
    values: list[str] = []
    lines = block.splitlines()
    in_field = False

    for line in lines:
        stripped = line.strip()

        if stripped.startswith(field + ":"):
            in_field = True
            continue

        if in_field:
            if stripped.startswith("- "):
                values.append(stripped[2:].strip().strip('"').strip("'"))
                continue

            if stripped and not stripped.startswith("- ") and not line.startswith("      "):
                break

    return values


def load_routes_text() -> str:
    path = CONFIG_DIR / "model_routes.yaml"
    if not path.exists():
        die(f"Missing routing config: {path}")
    return path.read_text()


def routes_cmd(_: argparse.Namespace) -> None:
    text = load_routes_text()

    print(f"Routing config: {CONFIG_DIR / 'model_routes.yaml'}")
    print()

    for section in ["local_models", "remote_models", "quantum_models"]:
        blocks = extract_yaml_blocks(text, section)
        print(section + ":")
        if not blocks:
            print("  none")
            continue

        for name, block in blocks.items():
            provider = block_field(block, "provider") or "unknown"
            model = block_field(block, "model") or "unknown"
            agent = block_field(block, "agent") or "-"
            approval = block_field(block, "requires_human_approval") or "-"
            edits = block_field(block, "edits_files") or "-"
            tags = block_list_values(block, "trigger_tags")

            print(f"  - {name}")
            print(f"      provider: {provider}")
            print(f"      model: {model}")
            print(f"      agent: {agent}")
            print(f"      requires_human_approval: {approval}")
            print(f"      edits_files: {edits}")
            if tags:
                print(f"      trigger_tags: {', '.join(tags)}")
        print()


def score_route(query: str, name: str, block: str, section: str) -> int:
    q = query.lower()
    score = 0

    if section == "local_models":
        use_for = block_list_values(block, "use_for")
        for item in use_for:
            if item.replace("_", " ") in q or item in q:
                score += 2

        if any(x in q for x in ["build", "implement", "code", "test", "bugfix"]):
            if name == "coder":
                score += 5
        if any(x in q for x in ["patch", "failure", "fix"]):
            if name == "patch":
                score += 5
        if any(x in q for x in ["review", "plan", "architecture", "risk"]):
            if name == "reviewer":
                score += 5
        if any(x in q for x in ["close", "docs", "summary"]):
            if name == "stable":
                score += 5

    else:
        tags = block_list_values(block, "trigger_tags")
        use_for = block_list_values(block, "use_for")

        for tag in tags:
            if tag.lower() in q:
                score += 10

        for item in use_for:
            if item.replace("_", " ") in q or item in q:
                score += 3

        if section == "quantum_models" and any(x in q for x in ["quantum", "ising", "calibration", "qec"]):
            score += 5

    return score


def route_cmd(args: argparse.Namespace) -> None:
    query = args.query
    text = load_routes_text()

    candidates: list[tuple[int, str, str, str]] = []
    for section in ["local_models", "remote_models", "quantum_models"]:
        blocks = extract_yaml_blocks(text, section)
        for name, block in blocks.items():
            candidates.append((score_route(query, name, block, section), section, name, block))

    candidates = sorted(candidates, key=lambda x: x[0], reverse=True)
    best = candidates[0] if candidates else None

    if not best or best[0] <= 0:
        print("Recommended route: local reviewer")
        print("Reason: no strong tag match; local-first default.")
        return

    score, section, name, block = best
    provider = block_field(block, "provider") or "unknown"
    model = block_field(block, "model") or "unknown"
    agent = block_field(block, "agent") or "-"
    approval = block_field(block, "requires_human_approval") or "false"
    edits = block_field(block, "edits_files") or ("true" if section == "local_models" else "false")
    tags = block_list_values(block, "trigger_tags")

    print(f"Recommended route: {name}")
    print(f"Section: {section}")
    print(f"Provider: {provider}")
    print(f"Model: {model}")
    print(f"Agent: {agent}")
    print(f"Requires human approval: {approval}")
    print(f"Edits files: {edits}")
    print(f"Score: {score}")
    if tags:
        print(f"Matched/available tags: {', '.join(tags)}")


def workflows_cmd(_: argparse.Namespace) -> None:
    """Single coherent workflow view: declarative YAMLs, registry roles, skill resolution."""
    files = list_yaml_files(WORKFLOWS_DIR)

    print(f"Workflow definitions (declarative YAML): {WORKFLOWS_DIR}")
    print()
    if not files:
        print("  No workflow YAML files found.")
    else:
        for path in files:
            text = path.read_text()
            name = ""
            description = ""
            for line in text.splitlines():
                stripped = line.strip()
                if stripped.startswith("name:"):
                    name = stripped.split(":", 1)[1].strip()
                elif stripped.startswith("description:"):
                    description = stripped.split(":", 1)[1].strip()
            print(f"- {name or path.stem}: {description}")
            print(f"  file: {path}")

    registry_roles = parse_registry_map("workflows.yaml", "workflows")
    if registry_roles:
        print()
        print("Workflow roles (registry/workflows.yaml):")
        for name, fields in registry_roles.items():
            print(f"- {name}: {fields.get('role', '—')}")

    skill_resolution = CONFIG_DIR / "skill_resolution.yaml"
    if skill_resolution.exists():
        print()
        print(f"Skill resolution mapping: {skill_resolution}")
        print(f"  Inspect with `{CLI_NAME} skills` or `{CLI_NAME} skills-for <workflow> <phase>`.")


def resolve_validation_script(profile: str) -> Path:
    """Honor the script: field in validation_profiles.yaml, else checks/<profile>.sh."""
    profiles_file = CONFIG_DIR / "validation_profiles.yaml"
    if profiles_file.exists():
        current: str | None = None
        for line in profiles_file.read_text(errors="replace").splitlines():
            stripped = line.strip()
            if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
                current = stripped[:-1]
            elif current == profile and stripped.startswith("script:"):
                rel = stripped.split(":", 1)[1].strip().strip('"\'')
                return (AGENT_SYSTEM_DIR / rel) if not rel.startswith("/") else Path(rel)
    return CHECKS_DIR / f"{profile}.sh"


def repo_default_profile() -> str | None:
    cwd = Path.cwd().resolve()
    repos = parse_registry_map("repos.yaml", "repos")
    for fields in repos.values():
        raw = fields.get("path")
        if not raw:
            continue
        try:
            if Path(raw).expanduser().resolve() == cwd:
                return fields.get("default_profile")
        except OSError:
            continue
    return None


def validate_cmd(args: argparse.Namespace) -> None:
    profile = args.profile or repo_default_profile()
    if not profile:
        die(f"No --profile given and no default_profile registered for this repo. "
            f"Pass --profile <name> or register the repo with `{CLI_NAME} register-project`.")

    if profile == "none":
        print("Validation profile is 'none' (not applicable for this repo). Skipping.")
        return

    script = resolve_validation_script(profile)

    if not script.exists():
        die(f"Missing validation script for profile '{profile}': {script}")

    print(f"Running validation profile: {profile}")
    print(f"Script: {script}")
    print()

    result = subprocess.run(
        ["bash", str(script)],
        text=True,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
    )

    output = result.stdout or ""
    print(output)

    try:
        tid = current_task_id()
        td = task_dir(tid)
        outbox = td / "outbox"
        outbox.mkdir(parents=True, exist_ok=True)
        summary = outbox / f"test.{profile}.md"
        status = "pass" if result.returncode == 0 else "fail"
        summary.write_text(
            f"# TEST summary\\n\\n"
            f"## Profile\\n\\n{profile}\\n\\n"
            f"## Status\\n\\n{status}\\n\\n"
            f"## Command\\n\\n`bash {script}`\\n\\n"
            f"## Output\\n\\n```text\\n{output}\\n```\\n"
        )
        validation_file = td / "VALIDATION.md"
        if validation_file.exists():
            append_markdown(
                validation_file,
                f"\n## Validation: {profile} ({status})\n\n"
                f"- Captured: {now()}\n"
                f"- Summary: `{summary}`\n"
                f"- Command: `bash {script}`\n"
            )
        print(f"Validation summary written to: {summary}")
    except Exception:
        pass

    raise SystemExit(result.returncode)




