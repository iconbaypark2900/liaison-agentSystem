def load_capabilities_text() -> str:
    path = CONFIG_DIR / "capability_routes.yaml"
    if not path.exists():
        die(f"Missing capability config: {path}")
    return path.read_text()


def capabilities_cmd(_: argparse.Namespace) -> None:
    text = load_capabilities_text()
    blocks = extract_yaml_blocks(text, "capabilities")

    print(f"Capability config: {CONFIG_DIR / 'capability_routes.yaml'}")
    print()

    if not blocks:
        print("No capabilities found.")
        return

    for name, block in blocks.items():
        description = block_field(block, "description") or "-"
        remote_allowed = block_field(block, "remote_allowed") or "-"
        remote_read_only = block_field(block, "remote_read_only") or "-"
        approval = block_field(block, "requires_human_approval") or "-"
        preferred = block_list_values(block, "preferred_routes")
        fallback = block_list_values(block, "fallback_routes")
        tags = block_list_values(block, "trigger_tags")

        print(f"- {name}")
        print(f"  description: {description}")
        print(f"  preferred_routes: {', '.join(preferred) if preferred else '-'}")
        print(f"  fallback_routes: {', '.join(fallback) if fallback else '-'}")
        print(f"  remote_allowed: {remote_allowed}")
        print(f"  remote_read_only: {remote_read_only}")
        print(f"  requires_human_approval: {approval}")
        if tags:
            print(f"  trigger_tags: {', '.join(tags)}")
        print()


def capability_cmd(args: argparse.Namespace) -> None:
    name = args.name
    text = load_capabilities_text()
    blocks = extract_yaml_blocks(text, "capabilities")

    if name not in blocks:
        print(f"Capability not found: {name}")
        print()
        print("Available capabilities:")
        for key in blocks:
            print(f"  - {key}")
        raise SystemExit(1)

    block = blocks[name]
    print(f"Capability: {name}")
    print(f"Config: {CONFIG_DIR / 'capability_routes.yaml'}")
    print()

    description = block_field(block, "description") or "-"
    remote_allowed = block_field(block, "remote_allowed") or "-"
    remote_read_only = block_field(block, "remote_read_only") or "-"
    approval = block_field(block, "requires_human_approval") or "-"
    preferred = block_list_values(block, "preferred_routes")
    fallback = block_list_values(block, "fallback_routes")
    tags = block_list_values(block, "trigger_tags")

    print(f"description: {description}")
    print(f"preferred_routes: {', '.join(preferred) if preferred else '-'}")
    print(f"fallback_routes: {', '.join(fallback) if fallback else '-'}")
    print(f"remote_allowed: {remote_allowed}")
    print(f"remote_read_only: {remote_read_only}")
    print(f"requires_human_approval: {approval}")
    if tags:
        print(f"trigger_tags: {', '.join(tags)}")

    print()
    print("Resolution preview:")

    if preferred:
        selected = preferred[0]
        print(f"  selected_route: {selected}")
        print(f"  fallback_routes: {', '.join(fallback) if fallback else '-'}")

        route_text = load_routes_text()
        found = False
        for section in ["local_models", "remote_models", "quantum_models"]:
            route_blocks = extract_yaml_blocks(route_text, section)
            if selected in route_blocks:
                selected_block = route_blocks[selected]
                print(f"  route_section: {section}")
                print(f"  provider: {block_field(selected_block, 'provider') or '-'}")
                print(f"  model: {block_field(selected_block, 'model') or '-'}")
                print(f"  agent: {block_field(selected_block, 'agent') or '-'}")
                found = True
                break
        if not found:
            print("  selected_route_status: route not found in model_routes.yaml")


def validations_cmd(_: argparse.Namespace) -> None:
    path = CONFIG_DIR / "validation_profiles.yaml"
    if not path.exists():
        die(f"Missing validation profile config: {path}")

    text = path.read_text()
    blocks = extract_yaml_blocks(text, "profiles")

    print(f"Validation profile config: {path}")
    print()

    if not blocks:
        print("No validation profiles found.")
        return

    for name, block in blocks.items():
        script = block_field(block, "script") or "-"
        required = block_list_values(block, "required_files")
        print(f"- {name}")
        print(f"  script: {script}")
        print(f"  required_files: {', '.join(required) if required else '-'}")
        print()


def skills_cmd(_: argparse.Namespace) -> None:
    path = CONFIG_DIR / "skill_resolution.yaml"
    if not path.exists():
        die(f"Missing skill resolution config: {path}")

    print(f"Skill resolution config: {path}")
    print()

    text = path.read_text()

    current_workflow = None
    current_phase = None

    for line in text.splitlines():
        stripped = line.strip()
        if not stripped or stripped.startswith("#") or stripped == "version: 1" or stripped == "workflows:":
            continue

        if line.startswith("  ") and not line.startswith("    ") and stripped.endswith(":"):
            current_workflow = stripped[:-1]
            print(f"- workflow: {current_workflow}")
            current_phase = None
            continue

        if line.startswith("    ") and not line.startswith("      ") and stripped.endswith(":"):
            current_phase = stripped[:-1]
            print(f"  {current_phase}:")
            continue

        if line.startswith("      - "):
            skill = stripped[2:].strip()
            print(f"    - {skill}")

    print()
    print(f"Global skill directory: {AGENT_SYSTEM_DIR / 'skills'}")


def research_workers_cmd(_: argparse.Namespace) -> None:
    path = CONFIG_DIR / "research_workers.yaml"
    if not path.exists():
        die(f"Missing research worker config: {path}")

    text = path.read_text()
    blocks = extract_yaml_blocks(text, "research_workers")

    print(f"Research worker config: {path}")
    print()

    if not blocks:
        print("No research workers found.")
        return

    for name, block in blocks.items():
        provider = block_field(block, "provider") or "-"
        tool = block_field(block, "tool") or "-"
        status = block_field(block, "status") or "-"
        approval = block_field(block, "requires_human_approval") or "-"
        sandbox = block_field(block, "sandbox_only") or "-"
        use_for = block_list_values(block, "use_for")
        forbidden = block_list_values(block, "forbidden")

        print(f"- {name}")
        print(f"  provider: {provider}")
        print(f"  tool: {tool}")
        print(f"  status: {status}")
        print(f"  requires_human_approval: {approval}")
        print(f"  sandbox_only: {sandbox}")
        print(f"  use_for: {', '.join(use_for) if use_for else '-'}")
        if forbidden:
            print(f"  forbidden: {', '.join(forbidden)}")
        print()


def context_cmd(args: argparse.Namespace) -> None:
    """Read-only command to generate context bundles for a given phase."""
    phase = args.phase
    if phase not in ROUTES:
        die(f"Unknown phase: {phase}")

    tid = current_task_id()
    td = task_dir(tid)
    state = read_state(tid)
    
    # Create task context directory
    context_dir = td / "context"
    context_dir.mkdir(parents=True, exist_ok=True)
    
    # Read task description from TASK.md
    task_file = td / "TASK.md"
    task_desc = "No task description found"
    if task_file.exists():
        task_desc = task_file.read_text()
    
    # Get current task state if available
    current_state = state.get("CURRENT_PHASE", "unknown")
    
    # Get approved prior outputs - only include those from phases before the requested phase
    approved_files = sorted((td / "approved").glob("*.md"))
    approved_content = []
    
    # Determine the index of the requested phase in the PHASES order
    phase_index = PHASES.index(phase)
    
    # Only include approved files from phases that occurred before the current phase
    for approved_file in approved_files:
        # Extract the phase from the filename (e.g., "plan.md", "build.md", etc.)
        file_name = approved_file.name
        if file_name.endswith(".md"):
            file_phase = file_name[:-3]  # Remove .md extension
            # Only include if the file's phase occurred before the requested phase
            if file_phase in PHASES and PHASES.index(file_phase) < phase_index:
                approved_content.append(f"- {approved_file.name}")
                approved_content.append(approved_file.read_text())
                approved_content.append("")
    
    # Get handoff file if present
    handoff_file = td / "handoff" / f"{phase}.md"
    handoff_content = ""
    if handoff_file.exists():
        handoff_content = handoff_file.read_text()
    
    # Get skills resolved from skill_resolution.yaml
    skills = resolve_skills_for("python-cli", phase)
    
    # Get policy files from $LIAISON_ROOT/policies/
    policies = []
    policies_dir = AGENT_SYSTEM_DIR / "policies"
    if policies_dir.exists():
        for policy_file in policies_dir.glob("*.md"):
            policies.append(f"- {policy_file.name}")
            policies.append(policy_file.read_text())
            policies.append("")
    
    # Get validation summaries from outbox/test.*.md if present
    validation_summaries = []
    outbox_dir = td / "outbox"
    if outbox_dir.exists():
        test_files = sorted(outbox_dir.glob("test.*.md"))
        for test_file in test_files:
            validation_summaries.append(f"- {test_file.name}")
            validation_summaries.append(test_file.read_text())
            validation_summaries.append("")
    
    # Write context bundle files
    context_md = context_dir / f"{phase}.md"
    context_md.write_text(dedent(f"""\
        # Context bundle for task: {tid}
        ## Phase: {phase}

        ### Task ID
        {tid}

        ### Task Description
        {task_desc}

        ### Requested Phase
        {phase}

        ### Current Task State
        {current_state}

        ### Approved Prior Outputs
        {'\n'.join(approved_content) if approved_content else "No approved files found"}

        ### Handoff File for Phase
        {handoff_content if handoff_content else "No handoff file found"}

        ### Resolved Skills
        {'\n'.join(skills) if skills else "No skills resolved"}

        ### Relevant Policies
        {'\n'.join(policies) if policies else "No policy files found"}

        ### Validation Summaries
        {'\n'.join(validation_summaries) if validation_summaries else "No validation summaries found"}

        ### Required Output File for Phase
        {outbox_dir / f"{phase}.md"}

        ### Instruction
        Chat history is not the source of truth for this phase.
    """))

    # Write manifest file
    manifest_file = context_dir / f"{phase}.manifest.json"
    import json
    # Create filtered list of approved files for manifest 
    manifest_approved_files = [f for f in approved_files if 
                              f.name[:-3] in PHASES and PHASES.index(f.name[:-3]) < phase_index]
    manifest = {
        "task_id": tid,
        "task_description": task_desc,
        "requested_phase": phase,
        "current_task_state": current_state,
        "approved_prior_outputs": [f.name for f in manifest_approved_files],
        "handoff_file_for_phase": str(handoff_file) if handoff_file.exists() else None,
        "resolved_skills": skills,
        "relevant_policies": [f.name for f in policies_dir.glob("*.md")] if policies_dir.exists() else [],
        "validation_summaries": [f.name for f in test_files] if test_files else [],
        "required_output_file": str(outbox_dir / f"{phase}.md"),
        "instruction": "Chat history is not the source of truth for this phase."
    }
    manifest_file.write_text(json.dumps(manifest, indent=2))
    
    # Write build summary to outbox directory
    build_summary_file = td / "outbox" / "build.md"
    build_summary_file.write_text(dedent(f"""\
        # BUILD summary for task: {tid}

        ## Context bundle generation

        Generated context bundle for phase: {phase}
        
        ### Files created:
        - {context_md}
        - {manifest_file}
        
        Context bundle contains:
        - task id: {tid}
        - task description from TASK.md
        - requested phase: {phase}
        - current task state: {current_state}
        - approved prior outputs
        - handoff file for the phase if present
        - skill names resolved from $LIAISON_ROOT/config/skill_resolution.yaml
        - relevant policy files from $LIAISON_ROOT/policies/
        - validation summaries from outbox/test.*.md if present
        - required output file path for the phase
        - instruction that chat history is not the source of truth
    """))

    print(f"Context bundle generated for phase {phase}")
    print(f"Files created:")
    print(f"  {context_md}")
    print(f"  {manifest_file}")
    print(f"  {build_summary_file}")
    
    # Optionally show the context file
    if getattr(args, 'show', False):
        print("\n--- Context file contents ---")
        print(context_md.read_text())

    if getattr(args, "show", False):
        try:
            tid = current_task_id()
            md_path = task_dir(tid) / "context" / f"{args.phase}.md"
            print()
            print(md_path.read_text())
        except Exception as exc:
            die(f"Could not show generated context bundle: {exc}")



def budget_cmd(_: argparse.Namespace) -> None:
    limits_path = CONFIG_DIR / "budget_limits.yaml"
    log_path = LOGS_DIR / "remote_call_log.jsonl"

    print(f"Budget config: {limits_path}")
    if limits_path.exists():
        print()
        print(limits_path.read_text())
    else:
        print("Missing budget config.")

    today = datetime.now().date().isoformat()
    month = today[:7]
    today_total = 0.0
    month_total = 0.0
    calls_today = 0
    calls_month = 0

    if log_path.exists():
        import json

        for line in log_path.read_text().splitlines():
            if not line.strip():
                continue
            try:
                item = json.loads(line)
            except Exception:
                continue

            ts = str(item.get("timestamp", ""))
            cost = float(item.get("estimated_cost_usd", 0) or 0)

            if ts.startswith(today):
                today_total += cost
                calls_today += 1
            if ts.startswith(month):
                month_total += cost
                calls_month += 1

    print("Remote usage:")
    print(f"  today calls: {calls_today}")
    print(f"  today estimated cost: ${today_total:.4f}")
    print(f"  month calls: {calls_month}")
    print(f"  month estimated cost: ${month_total:.4f}")
    print(f"  log file: {log_path}")



# ---------------------------------------------------------------------
# Phase 4 capability-based remote request skeleton
# ---------------------------------------------------------------------

def load_capability_blocks() -> dict[str, str]:
    path = CONFIG_DIR / "capability_routes.yaml"
    if not path.exists():
        die(f"Missing capability config: {path}")
    return extract_yaml_blocks(path.read_text(), "capabilities")


def resolve_capability(capability: str) -> dict:
    blocks = load_capability_blocks()
    if capability not in blocks:
        available = ", ".join(blocks.keys())
        die(f"Unknown capability: {capability}. Available: {available}")

    block = blocks[capability]
    return {
        "name": capability,
        "description": block_field(block, "description") or "-",
        "preferred_routes": block_list_values(block, "preferred_routes"),
        "fallback_routes": block_list_values(block, "fallback_routes"),
        "trigger_tags": block_list_values(block, "trigger_tags"),
        "remote_allowed": (block_field(block, "remote_allowed") or "false").lower(),
        "remote_read_only": (block_field(block, "remote_read_only") or "false").lower(),
        "requires_human_approval": (block_field(block, "requires_human_approval") or "true").lower(),
    }


def resolve_route(route_name: str) -> dict:
    route_text = load_routes_text()

    for section in ["local_models", "remote_models", "quantum_models"]:
        route_blocks = extract_yaml_blocks(route_text, section)
        if route_name in route_blocks:
            block = route_blocks[route_name]
            return {
                "name": route_name,
                "section": section,
                "provider": block_field(block, "provider") or "-",
                "model": block_field(block, "model") or "-",
                "agent": block_field(block, "agent") or "-",
                "trigger_tags": block_list_values(block, "trigger_tags"),
            }

    die(f"Route '{route_name}' was referenced by capability config but not found in model_routes.yaml")


def remote_capabilities_cmd(_: argparse.Namespace) -> None:
    blocks = load_capability_blocks()
    print(f"Remote-capable capabilities from: {CONFIG_DIR / 'capability_routes.yaml'}")
    print()

    found = False
    for name, block in blocks.items():
        remote_allowed = (block_field(block, "remote_allowed") or "false").lower()
        if remote_allowed != "true":
            continue

        found = True
        preferred = block_list_values(block, "preferred_routes")
        fallback = block_list_values(block, "fallback_routes")
        tags = block_list_values(block, "trigger_tags")

        print(f"- {name}")
        print(f"  description: {block_field(block, 'description') or '-'}")
        print(f"  preferred_routes: {', '.join(preferred) if preferred else '-'}")
        print(f"  fallback_routes: {', '.join(fallback) if fallback else '-'}")
        print(f"  remote_read_only: {block_field(block, 'remote_read_only') or '-'}")
        print(f"  requires_human_approval: {block_field(block, 'requires_human_approval') or '-'}")
        if tags:
            print(f"  trigger_tags: {', '.join(tags)}")
        print()

    if not found:
        print("No remote-capable capabilities found.")


def request_remote_cmd(args: argparse.Namespace) -> None:
    capability = args.capability
    request_text = args.request_text

    tid = current_task_id()
    td = task_dir(tid)

    cap = resolve_capability(capability)
    if cap["remote_allowed"] != "true":
        die(f"Capability is not remote-enabled: {capability}")

    if not cap["preferred_routes"]:
        die(f"Capability has no preferred_routes: {capability}")

    selected_route = cap["preferred_routes"][0]
    route = resolve_route(selected_route)

    remote_dir = td / "remote"
    remote_dir.mkdir(parents=True, exist_ok=True)

    request_file = remote_dir / f"request.{capability}.md"
    timestamp = datetime.now().isoformat(timespec="seconds")

    request_file.write_text(
        f"# Remote Request\n\n"
        f"## Status\n\npending_approval\n\n"
        f"## Task ID\n\n{tid}\n\n"
        f"## Capability\n\n{capability}\n\n"
        f"## Selected Route\n\n{selected_route}\n\n"
        f"## Fallback Routes\n\n{', '.join(cap.get('fallback_routes', [])) or '-'}\n\n"
        f"## Provider\n\n{route.get('provider', '-')}\n\n"
        f"## Model\n\n{route.get('model', '-')}\n\n"
        f"## Remote Read Only\n\n{cap.get('remote_read_only', '-')}\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Request Text\n\n{request_text}\n"
    )

    print(f"Remote request created: {request_file}")


def approve_remote_cmd(args: argparse.Namespace) -> None:
    capability = args.capability

    tid = current_task_id()
    td = task_dir(tid)

    remote_dir = td / "remote"
    request_file = remote_dir / f"request.{capability}.md"
    approved_file = remote_dir / f"approved.{capability}.md"

    if not request_file.exists():
        die(f"Missing remote request file: {request_file}")

    timestamp = datetime.now().isoformat(timespec="seconds")

    approved_file.write_text(
        f"# Approved Remote Request\n\n"
        f"## Status\n\napproved\n\n"
        f"## Approved By\n\nhuman\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Source Request\n\n{request_file}\n\n"
        f"## Approved Content\n\n"
        f"{request_file.read_text()}\n"
    )

    print(f"Remote request approved: {approved_file}")


def remote_run_cmd(args: argparse.Namespace) -> None:
    capability = args.capability

    is_stub = bool(getattr(args, "stub", False))
    is_real = bool(getattr(args, "real", False))
    is_dry_run = bool(getattr(args, "dry_run", False))

    if is_stub and (is_real or is_dry_run):
        die("Use either --stub or --real --dry-run, not both.")

    if not is_stub and not (is_real and is_dry_run):
        die("remote-run requires either --stub or --real --dry-run. Real endpoint execution is not enabled.")

    tid = current_task_id()
    td = task_dir(tid)

    cap = resolve_capability(capability)
    if cap["remote_allowed"] != "true":
        die(f"Capability is not remote-enabled: {capability}")

    if not cap["preferred_routes"]:
        die(f"Capability has no preferred_routes: {capability}")

    selected_route = cap["preferred_routes"][0]
    route = resolve_route(selected_route)

    remote_dir = td / "remote"
    outbox_dir = td / "outbox"
    remote_dir.mkdir(parents=True, exist_ok=True)
    outbox_dir.mkdir(parents=True, exist_ok=True)

    approved_file = remote_dir / f"approved.{capability}.md"

    if not approved_file.exists():
        die(f"Missing approved remote request file: {approved_file}")

    timestamp = datetime.now().isoformat(timespec="seconds")

    import json

    if is_stub:
        output_file = outbox_dir / f"remote.{capability}.md"

        output_file.write_text(
            f"# Remote Stub Output\n\n"
            f"## Status\n\nstub_not_executed\n\n"
            f"## Task ID\n\n{tid}\n\n"
            f"## Capability\n\n{capability}\n\n"
            f"## Selected Route\n\n{selected_route}\n\n"
            f"## Provider\n\n{route.get('provider', '-')}\n\n"
            f"## Model\n\n{route.get('model', '-')}\n\n"
            f"## Timestamp\n\n{timestamp}\n\n"
            f"## Result\n\n"
            f"Remote execution is not enabled yet. This is a governance dry run.\n\n"
            f"No endpoint call was made. No API key was used. No network call was made.\n"
        )

        LOGS_DIR.mkdir(parents=True, exist_ok=True)
        log_path = LOGS_DIR / "remote_call_log.jsonl"

        record = {
            "timestamp": timestamp,
            "task_id": tid,
            "phase": "remote_run",
            "capability": capability,
            "selected_route": selected_route,
            "provider": route.get("provider", "-"),
            "model": route.get("model", "-"),
            "approved_by": "human",
            "prompt_file": str(approved_file),
            "output_file": str(output_file),
            "latency_seconds": 0,
            "estimated_cost_usd": 0.0,
            "status": "stub_not_executed",
        }

        with log_path.open("a") as f:
            f.write(json.dumps(record) + "\n")

        print(f"Remote stub output written: {output_file}")
        print(f"Remote call log updated: {log_path}")
        return

    # --real --dry-run path only. No real endpoint execution.
    if cap.get("remote_read_only") != "true":
        die(f"Capability is not marked remote_read_only: {capability}")

    provider = route.get("provider", "-")
    model = route.get("model", "-")

    if provider != "nvidia_nim":
        die(f"Phase 8A dry-run only supports provider nvidia_nim, got: {provider}")

    import os

    api_key_present = bool(os.environ.get("NVIDIA_API_KEY"))

    payload_file = outbox_dir / f"remote_payload.{capability}.json"
    summary_file = outbox_dir / f"remote_dry_run.{capability}.md"

    approved_content = approved_file.read_text()

    payload = {
        "task_id": tid,
        "capability": capability,
        "selected_route": selected_route,
        "provider": provider,
        "model": model,
        "dry_run": True,
        "api_key_present": api_key_present,
        "request_source_file": str(approved_file),
        "output_file": str(summary_file),
        "messages": [
            {
                "role": "system",
                "content": "You are a read-only architecture/research reviewer. Do not write files.",
            },
            {
                "role": "user",
                "content": approved_content,
            },
        ],
    }

    payload_file.write_text(json.dumps(payload, indent=2) + "\n")

    summary_file.write_text(
        f"# NIM Remote Dry Run\n\n"
        f"## Status\n\n"
        f"dry_run_not_executed\n\n"
        f"## Task ID\n\n{tid}\n\n"
        f"## Capability\n\n{capability}\n\n"
        f"## Selected Route\n\n{selected_route}\n\n"
        f"## Provider\n\n{provider}\n\n"
        f"## Model\n\n{model}\n\n"
        f"## Payload Path\n\n{payload_file}\n\n"
        f"## API Key Present\n\n{str(api_key_present).lower()}\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Safety Confirmation\n\n"
        f"No NVIDIA NIM endpoint call was made.\n"
        f"No network call was made.\n"
        f"No model execution occurred.\n"
        f"No paid compute was used.\n"
        f"NVIDIA_API_KEY was not printed.\n"
    )

    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOGS_DIR / "remote_call_log.jsonl"

    record = {
        "timestamp": timestamp,
        "task_id": tid,
        "phase": "remote_dry_run",
        "capability": capability,
        "selected_route": selected_route,
        "provider": provider,
        "model": model,
        "approved_by": "human",
        "prompt_file": str(approved_file),
        "output_file": str(summary_file),
        "latency_seconds": 0,
        "estimated_cost_usd": 0.0,
        "status": "dry_run_not_executed",
    }

    with log_path.open("a") as f:
        f.write(json.dumps(record) + "\n")

    print(f"Remote payload preview written: {payload_file}")
    print(f"Remote dry-run summary written: {summary_file}")
    print(f"Remote call log updated: {log_path}")



def _remote_run_dry_run(args: argparse.Namespace) -> None:
    """Handle --real --dry-run execution without making actual network calls."""
    capability = args.capability

    tid = current_task_id()
    td = task_dir(tid)

    cap = resolve_capability(capability)
    
    # Validate capability exists
    if cap["remote_allowed"] != "true":
        die(f"Capability is not remote-enabled: {capability}")

    # Validate remote_read_only
    if cap["remote_read_only"] != "true":
        die(f"Capability is not remote_read_only: {capability}")

    # Validate approved remote request file exists
    remote_dir = td / "remote"
    approved_file = remote_dir / f"approved.{capability}.md"
    if not approved_file.exists():
        die(f"Missing approved remote request file: {approved_file}")

    # Check NVIDIA_API_KEY exists in environment
    api_key_present = "NVIDIA_API_KEY" in os.environ
    
    # Determine selected route
    if not cap["preferred_routes"]:
        die(f"Capability has no preferred_routes: {capability}")
    
    selected_route = cap["preferred_routes"][0]
    route = resolve_route(selected_route)
    
    # Validate provider is nvidia_nim
    if route.get("provider") != "nvidia_nim":
        die(f"Capability must use nvidia_nim provider. Got: {route.get('provider')}")

    # Generate NIM payload preview
    timestamp = datetime.now().isoformat(timespec="seconds")
    
    # Create dry-run payload file
    payload_file = td / "outbox" / f"remote_payload.{capability}.json"
    payload_file.parent.mkdir(parents=True, exist_ok=True)
    
    # Create a mock NIM request payload (simplified structure)
    payload_data = {
        "model": route.get("model", "-"),
        "messages": [
            {
                "role": "user",
                "content": "Sample prompt for dry-run"
            }
        ],
        "temperature": 0.7,
        "max_tokens": 1024,
        "top_p": 0.9
    }
    
    import json
    payload_file.write_text(json.dumps(payload_data, indent=2))
    
    # Create dry-run markdown file
    dry_run_file = td / "outbox" / f"remote_dry_run.{capability}.md"
    dry_run_file.parent.mkdir(parents=True, exist_ok=True)
    
    dry_run_content = f"""# NIM Dry Run Payload Preview

## Request Details
- Task ID: {tid}
- Capability: {capability}
- Selected Route: {selected_route}
- Provider: {route.get('provider', '-')}
- Model: {route.get('model', '-')}
- Timestamp: {timestamp}

## API Status
- NVIDIA_API_KEY present: {api_key_present}

## Payload Preview
This is a preview of the NIM request payload that would be sent:
```json
{json.dumps(payload_data, indent=2)}
```

## Dry-Run Summary
This is a dry-run only - no actual endpoint call was made.
No network call was made.
No API key was used.
No paid compute was performed.
"""

    dry_run_file.write_text(dry_run_content)
    
    # Append to remote call log
    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOGS_DIR / "remote_call_log.jsonl"
    
    record = {
        "timestamp": timestamp,
        "task_id": tid,
        "phase": "remote_dry_run",
        "capability": capability,
        "selected_route": selected_route,
        "provider": route.get("provider", "-"),
        "model": route.get("model", "-"),
        "approved_by": "human",
        "prompt_file": str(approved_file),
        "output_file": str(payload_file),
        "latency_seconds": 0,
        "estimated_cost_usd": 0.0,
        "status": "dry_run_not_executed"
    }

    with log_path.open("a") as f:
        f.write(json.dumps(record) + "\n")

    print(f"Dry-run payload written: {payload_file}")
    print(f"Dry-run markdown written: {dry_run_file}")
    print(f"Remote call log updated: {log_path}")

    # Also write a build summary file
    build_summary_file = td / "outbox" / "build.md"
    build_summary_file.parent.mkdir(parents=True, exist_ok=True)
    build_summary_file.write_text(f"""# BUILD summary for task: {tid}

## NIM Dry-run execution
Built NIM request payload for capability: {capability}

### Files created:
- {payload_file}
- {dry_run_file}
- {log_path}

### Validation
All validations passed:
1. Capability exists
2. Remote allowed: true
3. Remote read only: true
4. Approved remote request file exists
5. Selected route resolves
6. Provider is nvidia_nim
7. NVIDIA_API_KEY exists in environment: {api_key_present}
""")


def _remote_run_stub(args: argparse.Namespace) -> None:
    """Handle the original --stub behavior to maintain backward compatibility."""
    capability = args.capability

    tid = current_task_id()
    td = task_dir(tid)

    cap = resolve_capability(capability)
    if cap["remote_allowed"] != "true":
        die(f"Capability is not remote-enabled: {capability}")

    if not cap["preferred_routes"]:
        die(f"Capability has no preferred_routes: {capability}")

    selected_route = cap["preferred_routes"][0]
    route = resolve_route(selected_route)

    remote_dir = td / "remote"
    outbox_dir = td / "outbox"
    remote_dir.mkdir(parents=True, exist_ok=True)
    outbox_dir.mkdir(parents=True, exist_ok=True)

    approved_file = remote_dir / f"approved.{capability}.md"
    output_file = outbox_dir / f"remote.{capability}.md"

    if not approved_file.exists():
        die(f"Missing approved remote request file: {approved_file}")

    timestamp = datetime.now().isoformat(timespec="seconds")

    output_file.write_text(
        f"# Remote Stub Output\n\n"
        f"## Status\n\nstub_not_executed\n\n"
        f"## Task ID\n\n{tid}\n\n"
        f"## Capability\n\n{capability}\n\n"
        f"## Selected Route\n\n{selected_route}\n\n"
        f"## Provider\n\n{route.get('provider', '-')}\n\n"
        f"## Model\n\n{route.get('model', '-')}\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Result\n\n"
        f"Remote execution is not enabled yet. This is a governance dry run.\n\n"
        f"No endpoint call was made. No API key was used. No network call was made.\n"
    )

    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOGS_DIR / "remote_call_log.jsonl"

    import json
    record = {
        "timestamp": timestamp,
        "task_id": tid,
        "phase": "remote_run",
        "capability": capability,
        "selected_route": selected_route,
        "provider": route.get("provider", "-"),
        "model": route.get("model", "-"),
        "approved_by": "human",
        "prompt_file": str(approved_file),
        "output_file": str(output_file),
        "latency_seconds": 0,
        "estimated_cost_usd": 0.0,
        "status": "stub_not_executed",
    }

    with log_path.open("a") as f:
        f.write(json.dumps(record) + "\n")

    print(f"Remote stub output written: {output_file}")
    print(f"Remote call log updated: {log_path}")



def load_research_worker_blocks() -> dict[str, str]:
    path = CONFIG_DIR / "research_workers.yaml"
    if not path.exists():
        die(f"Missing research worker config: {path}")
    return extract_yaml_blocks(path.read_text(), "research_workers")


def resolve_research_worker(worker_name: str) -> dict:
    blocks = load_research_worker_blocks()
    if worker_name not in blocks:
        available = ", ".join(blocks.keys())
        die(f"Unknown research worker: {worker_name}. Available: {available}")

    block = blocks[worker_name]
    return {
        "name": worker_name,
        "provider": block_field(block, "provider") or "-",
        "tool": block_field(block, "tool") or "-",
        "status": block_field(block, "status") or "-",
        "requires_human_approval": block_field(block, "requires_human_approval") or "true",
        "sandbox_only": block_field(block, "sandbox_only") or "true",
        "publishes_artifacts": block_field(block, "publishes_artifacts") or "-",
        "use_for": block_list_values(block, "use_for"),
        "writes_to": block_list_values(block, "writes_to"),
        "forbidden": block_list_values(block, "forbidden"),
    }


def request_research_cmd(args: argparse.Namespace) -> None:
    worker_name = args.worker_name
    request_text = args.request_text

    tid = current_task_id()
    td = task_dir(tid)

    worker = resolve_research_worker(worker_name)

    research_dir = td / "research"
    research_dir.mkdir(parents=True, exist_ok=True)

    request_file = research_dir / f"request.{worker_name}.md"
    timestamp = datetime.now().isoformat(timespec="seconds")

    request_file.write_text(
        f"# Research Worker Request\n\n"
        f"## Status\n\npending_approval\n\n"
        f"## Task ID\n\n{tid}\n\n"
        f"## Worker Name\n\n{worker_name}\n\n"
        f"## Provider\n\n{worker.get('provider', '-')}\n\n"
        f"## Tool\n\n{worker.get('tool', '-')}\n\n"
        f"## Worker Status\n\n{worker.get('status', '-')}\n\n"
        f"## Sandbox Only\n\n{worker.get('sandbox_only', '-')}\n\n"
        f"## Requires Human Approval\n\n{worker.get('requires_human_approval', '-')}\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Request Text\n\n{request_text}\n"
    )

    print(f"Research request created: {request_file}")


def approve_research_cmd(args: argparse.Namespace) -> None:
    worker_name = args.worker_name

    tid = current_task_id()
    td = task_dir(tid)

    research_dir = td / "research"
    request_file = research_dir / f"request.{worker_name}.md"
    approved_file = research_dir / f"approved.{worker_name}.md"

    if not request_file.exists():
        die(f"Missing research request file: {request_file}")

    timestamp = datetime.now().isoformat(timespec="seconds")

    approved_file.write_text(
        f"# Approved Research Worker Request\n\n"
        f"## Status\n\napproved\n\n"
        f"## Approved By\n\nhuman\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Source Request\n\n{request_file}\n\n"
        f"## Approved Content\n\n"
        f"{request_file.read_text()}\n"
    )

    print(f"Research request approved: {approved_file}")


def research_run_cmd(args: argparse.Namespace) -> None:
    worker_name = args.worker_name

    if not getattr(args, "stub", False):
        die("research-run currently requires --stub. Real ML-Intern execution is not enabled.")

    tid = current_task_id()
    td = task_dir(tid)

    worker = resolve_research_worker(worker_name)

    research_dir = td / "research"
    outbox_dir = td / "outbox"
    research_dir.mkdir(parents=True, exist_ok=True)
    outbox_dir.mkdir(parents=True, exist_ok=True)

    approved_file = research_dir / f"approved.{worker_name}.md"
    output_file = outbox_dir / f"research.{worker_name}.md"

    if not approved_file.exists():
        die(f"Missing approved research request file: {approved_file}")

    timestamp = datetime.now().isoformat(timespec="seconds")

    output_file.write_text(
        f"# Research Worker Stub Output\n\n"
        f"## Status\n\nstub_not_executed\n\n"
        f"## Task ID\n\n{tid}\n\n"
        f"## Worker Name\n\n{worker_name}\n\n"
        f"## Provider\n\n{worker.get('provider', '-')}\n\n"
        f"## Tool\n\n{worker.get('tool', '-')}\n\n"
        f"## Timestamp\n\n{timestamp}\n\n"
        f"## Result\n\n"
        f"Research worker execution is not enabled yet. This is a governance dry run.\n\n"
        f"No ML-Intern process was run. No Hugging Face call was made. No paid compute was used. No data was uploaded.\n"
    )

    LOGS_DIR.mkdir(parents=True, exist_ok=True)
    log_path = LOGS_DIR / "ml_intern_runs.jsonl"

    import json
    record = {
        "timestamp": timestamp,
        "task_id": tid,
        "phase": "research_run",
        "worker_name": worker_name,
        "provider": worker.get("provider", "-"),
        "tool": worker.get("tool", "-"),
        "approved_by": "human",
        "prompt_file": str(approved_file),
        "output_file": str(output_file),
        "latency_seconds": 0,
        "estimated_cost_usd": 0.0,
        "status": "stub_not_executed",
    }

    with log_path.open("a") as f:
        f.write(json.dumps(record) + "\n")

    print(f"Research stub output written: {output_file}")
    print(f"Research call log updated: {log_path}")


def events_cmd(args: argparse.Namespace) -> None:
    """Read current task events.jsonl"""
    task_id = current_task_id()
    task_dir = Path(".spark-flow/tasks") / task_id
    events_file = task_dir / "events.jsonl"
    
    if not events_file.exists():
        print("No events found for current task.")
        return
    
    # Read and print all events
    with open(events_file, "r") as f:
        for line in f:
            if line.strip():
                print(line.strip())


def skills_for_cmd(args: argparse.Namespace) -> None:
    """Return skills for workflow and phase"""
    workflow_name = args.workflow_name
    phase = args.phase
    
    skills = resolve_skills_for(workflow_name, phase)
    
    for skill in skills:
        print(skill)


def check_state_cmd(args: argparse.Namespace) -> None:
    """Verify current task state"""
    task_id = current_task_id()
    
    # Check that .spark-flow/current exists
    if not CURRENT_FILE.exists():
        die("Missing .spark-flow/current")
    
    # Check that current task directory exists
    task_dir = Path(".spark-flow/tasks") / task_id
    if not task_dir.exists():
        die(f"Missing task directory: {task_dir}")
    
    # Check that STATE.txt exists
    state_file = task_dir / "STATE.txt"
    if not state_file.exists():
        die(f"Missing STATE.txt: {state_file}")
    
    # Check that TASK.md exists
    task_file = task_dir / "TASK.md"
    if not task_file.exists():
        die(f"Missing TASK.md: {task_file}")
    
    # Check for nested duplicate directory
    duplicate_check = task_dir / task_id
    if duplicate_check.exists():
        die(f"Nested duplicate directory found: {duplicate_check}")
    
    # If we get here, all checks passed
    print("All state checks passed.")


