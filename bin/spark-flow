def terminal_session_cmd(args: argparse.Namespace) -> None:
    root = str(AGENT_SYSTEM_DIR)
    if root not in sys.path:
        sys.path.insert(0, root)
    _run_terminal_session_action(args)


def _run_terminal_session_action(args: argparse.Namespace) -> None:
    from dashboard.command_center.terminal_sessions import (
        complete_session,
        list_sessions,
        prune_dead_sessions,
        register_session,
    )
    from dashboard.command_center.project_plans import resolve_project_key_and_path

    action = getattr(args, "terminal_session_action", "list")
    if action == "list":
        print(json.dumps({"sessions": list_sessions()}))
        return
    if action == "prune":
        print(json.dumps({"sessions": prune_dead_sessions()}))
        return
    if action == "register":
        project_key = getattr(args, "project", None) or ""
        task_id = getattr(args, "task_id", None) or ""
        pattern_id = getattr(args, "pattern", None) or ""
        repo_path = getattr(args, "repo_path", None) or ""
        if project_key and not repo_path:
            _, repo_path = resolve_project_key_and_path(project_key)
        entry = register_session(
            agent_name=args.agent_name,
            launch=args.launch,
            pid=getattr(args, "pid", None),
            pane_title=getattr(args, "title", "") or args.agent_name,
            project_key=project_key,
            repo_path=repo_path,
            task_id=task_id,
            pattern_id=pattern_id,
        )
        print(json.dumps(entry))
        return
    if action == "complete":
        _run_observe_session_complete(args)
        return
    die("Unknown terminal-session action")


def observe_session_cmd(args: argparse.Namespace) -> None:
    root = str(AGENT_SYSTEM_DIR)
    if root not in sys.path:
        sys.path.insert(0, root)
    action = getattr(args, "observe_session_action", "complete")
    if action == "complete":
        _run_observe_session_complete(args)
        return
    if action == "start":
        args.terminal_session_action = "register"
        if not getattr(args, "agent_name", None):
            args.agent_name = getattr(args, "agent", None) or "hermes"
        _run_terminal_session_action(args)
        return
    if action == "watch":
        observe_session_watch_cmd(args)
        return
    die("Unknown observe-session action")


def _run_observe_session_complete(args: argparse.Namespace) -> None:
    from dashboard.command_center.terminal_sessions import complete_session

    agent = getattr(args, "agent", None) or getattr(args, "agent_name", None)
    result = complete_session(
        session_id=getattr(args, "session_id", None),
        agent_name=agent,
        exit_code=getattr(args, "exit_code", None),
        outcome=getattr(args, "outcome", None),
        log_excerpt=getattr(args, "log_excerpt", "") or "",
        log_file=getattr(args, "log_file", None),
        log_lines=getattr(args, "log_lines", 40),
        project_key=getattr(args, "project", None) or "",
        task_id=getattr(args, "task_id", None) or "",
        attach_file=getattr(args, "attach_file", None),
        attach_text=getattr(args, "attach_text", None),
        attach_title=getattr(args, "attach_title", "") or "",
    )
    print(json.dumps(result, indent=2))


def export_learning_bridge_cmd(args: argparse.Namespace) -> None:
    root = str(AGENT_SYSTEM_DIR)
    if root not in sys.path:
        sys.path.insert(0, root)
    from dashboard.command_center.learning_bridge import export_learning_bridge

    project = getattr(args, "project", None) or getattr(args, "from_project", None)
    if not project:
