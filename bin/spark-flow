def load_capabilities_text() -> str:
    path = CONFIG_DIR / "capability_routes.yaml"
    if not path.exists():
        die(f"Missing capability config: {path}")
    return path.read_text()


def capabilities_cmd(_: argparse.Namespace) -> None:
    text = load_capabilities_text()
    blocks = extract_yaml_blocks(text, "capabilities")

    print(f"Capability config: {CONFIG_DIR / 'capability_routes.yaml'}")
    print()

    if not blocks:
        print("No capabilities found.")
        return

    for name, block in blocks.items():
        description = block_field(block, "description") or "-"
        remote_allowed = block_field(block, "remote_allowed") or "-"
        remote_read_only = block_field(block, "remote_read_only") or "-"
        approval = block_field(block, "requires_human_approval") or "-"
        preferred = block_list_values(block, "preferred_routes")
        fallback = block_list_values(block, "fallback_routes")
        tags = block_list_values(block, "trigger_tags")

        print(f"- {name}")
        print(f"  description: {description}")
        print(f"  preferred_routes: {', '.join(preferred) if preferred else '-'}")
        print(f"  fallback_routes: {', '.join(fallback) if fallback else '-'}")
        print(f"  remote_allowed: {remote_allowed}")
        print(f"  remote_read_only: {remote_read_only}")
        print(f"  requires_human_approval: {approval}")
        if tags:
            print(f"  trigger_tags: {', '.join(tags)}")
        print()


def capability_cmd(args: argparse.Namespace) -> None:
    name = args.name
    text = load_capabilities_text()
    blocks = extract_yaml_blocks(text, "capabilities")

    if name not in blocks:
        print(f"Capability not found: {name}")
        print()
        print("Available capabilities:")
        for key in blocks:
            print(f"  - {key}")
        raise SystemExit(1)

    block = blocks[name]
    print(f"Capability: {name}")
    print(f"Config: {CONFIG_DIR / 'capability_routes.yaml'}")
    print()

    description = block_field(block, "description") or "-"
    remote_allowed = block_field(block, "remote_allowed") or "-"
    remote_read_only = block_field(block, "remote_read_only") or "-"
    approval = block_field(block, "requires_human_approval") or "-"
    preferred = block_list_values(block, "preferred_routes")
    fallback = block_list_values(block, "fallback_routes")
    tags = block_list_values(block, "trigger_tags")

    print(f"description: {description}")
    print(f"preferred_routes: {', '.join(preferred) if preferred else '-'}")
    print(f"fallback_routes: {', '.join(fallback) if fallback else '-'}")
    print(f"remote_allowed: {remote_allowed}")
    print(f"remote_read_only: {remote_read_only}")
    print(f"requires_human_approval: {approval}")
    if tags:
        print(f"trigger_tags: {', '.join(tags)}")

    print()
    print("Resolution preview:")

    if preferred:
        selected = preferred[0]
        print(f"  selected_route: {selected}")
        print(f"  fallback_routes: {', '.join(fallback) if fallback else '-'}")

        route_text = load_routes_text()
        found = False
        for section in ["local_models", "remote_models", "quantum_models"]:
            route_blocks = extract_yaml_blocks(route_text, section)
            if selected in route_blocks:
                selected_block = route_blocks[selected]
                print(f"  route_section: {section}")
                print(f"  provider: {block_field(selected_block, 'provider') or '-'}")
                print(f"  model: {block_field(selected_block, 'model') or '-'}")
                print(f"  agent: {block_field(selected_block, 'agent') or '-'}")
                found = True
                break
        if not found:
            print("  selected_route_status: route not found in model_routes.yaml")


