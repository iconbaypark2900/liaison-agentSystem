#!/usr/bin/env python3
"""
sigma-research — Reflexion-based edge research agent for sigma.

Runs a Reflexion loop that generates edge hypotheses, tests them against
sigma's fixed OOS window using the edge_research_harness.py backtest,
reflects on failures, and accumulates a research journal.

The OOS window is FIXED (2023-01-01 onward). The agent never sees OOS
data during hypothesis generation — only after the gate runs.

Examples:
    sigma-research "Does momentum work on quantum computing stocks?" \\
        --asset-class equity \\
        --universe IONQ,RGTI,QBTS,QUBT,RKLB,JOBY

    sigma-research "Is there mean-reversion edge in eVTOL stocks?" \\
        --asset-class equity \\
        --universe JOBY,ACHR,LILM \\
        --max-attempts 4

    sigma-research "Does MACD work on EUR/USD vs GBP/USD?" \\
        --asset-class forex \\
        --universe EUR_USD,GBP_USD,USD_JPY

    sigma-research --show-journal "Does momentum work on quantum computing stocks?"
"""

import argparse
import json
import sys
from pathlib import Path

_root = Path(__file__).resolve().parent.parent
if str(_root) not in sys.path:
    sys.path.insert(0, str(_root))

# Auto-load env tokens
_env = _root.parent / "chat-ui" / ".env.local"
if _env.exists():
    import os
    for _line in _env.read_text().splitlines():
        if "=" in _line and not _line.startswith("#"):
            k, _, v = _line.partition("=")
            if k.strip() and v.strip() and k.strip() not in os.environ:
                os.environ[k.strip()] = v.strip()


def _show_journal(question: str) -> None:
    from reflexion_dspy.research_journal import load_journal, journal_path
    journal = load_journal(question)
    path = journal_path(question)
    print(f"\nJournal: {path}")
    print(f"Outcome: {journal.get('outcome', 'unknown')}")
    print(f"Attempts: {len(journal.get('attempts', []))}")
    if journal.get("final_finding"):
        print(f"Finding: {journal['final_finding']}")
    print()
    for a in journal.get("attempts", []):
        status = "PASSED" if a.get("gate_passed") else "FAILED"
        print(f"  Attempt {a['attempt']} [{status}]")
        print(f"    Hypothesis: {str(a.get('hypothesis', ''))[:100]}...")
        print(f"    Strategies: {a.get('strategies')}")
        print(f"    Symbols: {a.get('symbols')}")
        print(f"    Failure mode: {a.get('failure_mode', 'n/a')}")
        print(f"    Reflection: {str(a.get('reflection', ''))[:120]}...")
        print()


def main() -> int:
    ap = argparse.ArgumentParser(
        description=__doc__,
        formatter_class=argparse.RawDescriptionHelpFormatter,
    )
    ap.add_argument("question", help="Research question to investigate")
    ap.add_argument("--asset-class", default="equity",
                    choices=["equity", "forex", "crypto"],
                    help="Asset class for equity harness (default: equity)")
    ap.add_argument("--universe",
                    default="AAPL,MSFT,NVDA,AMZN,GOOG,META,TSLA,JPM,V,WMT",
                    help="Comma-separated tickers (equity mode only)")
    ap.add_argument("--backtest-type", default="equity",
                    choices=["equity", "options_income"],
                    help="Type of backtest: 'equity' for strategy combiner, "
                         "'options_income' for SPY/QQQ put credit spread configs")
    ap.add_argument("--underlying", default="SPY",
                    choices=["SPY", "QQQ"],
                    help="Underlying for options_income mode (default: SPY)")
    ap.add_argument("--max-attempts", type=int, default=6,
                    help="Max hypothesis attempts before giving up (default: 6)")
    ap.add_argument("--show-journal", action="store_true",
                    help="Print the research journal and exit")
    ap.add_argument("--train-end", default=None,
                    help="Override the train cutoff date (default: 2022-12-31)")
    args = ap.parse_args()

    if args.show_journal:
        _show_journal(args.question)
        return 0

    # Override train-end if specified
    if args.train_end:
        import reflexion_dspy.research_agent as ra
        ra.TRAIN_END = args.train_end
        ra.OOS_START = args.train_end  # approximate

    from reflexion_dspy.research_agent import StrategyResearchAgent

    agent = StrategyResearchAgent(
        research_question=args.question,
        asset_class=args.asset_class,
        universe=args.universe,
        max_attempts=args.max_attempts,
        backtest_type=args.backtest_type,
        options_underlying=args.underlying,
    )

    outcome = agent.run()

    print("\n" + "=" * 60)
    print(f"OUTCOME: {'EDGE FOUND' if outcome.edge_found else 'NO EDGE FOUND'}")
    print(f"Attempts: {outcome.attempts}")
    print(f"Summary: {outcome.summary}")
    if outcome.edge_found:
        print(f"Winning strategy: {outcome.winning_strategy}")
        print(f"Symbols: {outcome.winning_symbols}")
        print(f"OOS stats: {json.dumps(outcome.oos_stats, indent=2)}")
    print("=" * 60)

    return 0 if outcome.edge_found else 1


if __name__ == "__main__":
    raise SystemExit(main())
